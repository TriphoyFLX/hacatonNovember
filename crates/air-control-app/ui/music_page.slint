import { ScrollView, Slider, Switch } from "std-widgets.slint";
import { CameraRow, Choice, PageTitle, PrimaryButton, Stage, TextButton } from "components.slint";

export component ChordPad inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    horizontal-stretch: 1;
    height: 40px;
    background: root.selected ? #0f766e : #eef5f0;
    border-radius: 8px;
    border-width: 1.5px;
    border-color: root.selected ? #14b8a6 : #d1e4d7;
    animate background { duration: 90ms; easing: ease-out; }
    Text {
        text: root.label;
        color: root.selected ? #ecfef8 : #174c38;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        overflow: elide;
    }
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

export component GuitarStringPad inherits Rectangle {
    in property <string> label;
    in property <float> energy;
    callback clicked();
    horizontal-stretch: 1;
    height: 46px;
    background: root.energy > 0.18 ? #fef3c7 : #f7f1e8;
    border-radius: 8px;
    border-width: 1.5px;
    border-color: root.energy > 0.18 ? #f59e0b : #dfd4c6;
    animate background { duration: 70ms; easing: ease-out; }
    Text {
        text: root.label;
        color: #3f3429;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component LiveString inherits Rectangle {
    in property <float> energy;
    in property <color> idle-color;
    width: 100%;
    height: root.energy > 0.12 ? 4px + root.energy * 6px : 3px;
    background: root.energy > 0.15 ? #fde68a : root.idle-color;
    border-radius: 2px;
    animate height { duration: 60ms; easing: ease-out; }
    animate background { duration: 60ms; easing: ease-out; }
}

component GuitarScene inherits Rectangle {
    in property <int> chord;
    in property <float> s0;
    in property <float> s1;
    in property <float> s2;
    in property <float> s3;
    in property <float> s4;
    in property <float> s5;
    in property <string> hit-label;
    in property <bool> overlay: false;
    background: root.overlay ? #00000000 : #0c1411;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                background: #12352c;
                border-radius: 8px;
                horizontal-stretch: 0;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 14px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "AIR GUITAR"; color: #5eead4; font-size: 12px; font-weight: 800; vertical-alignment: center; }
                        Text {
                            text: ["Em", "Am", "C", "G", "D", "A", "E", "F", "Dm", "Bm", "Em7", "Cadd9", "Dsus4", "Asus2", "F#m", "B7"][Math.min(root.chord, 15)];
                            color: #f0fdf4;
                            font-size: 22px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.hit-label != "" && root.hit-label != "—": Rectangle {
                background: #14532d;
                border-radius: 8px;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Text { text: root.hit-label; color: #bbf7d0; font-size: 13px; font-weight: 700; }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: root.overlay ? #1c140ecc : #2a1c12;
            border-radius: 14px;
            border-width: 1px;
            border-color: #7a5738;
            HorizontalLayout {
                padding: 0;
                Rectangle { width: 14px; background: #e8dfc7; border-top-left-radius: 14px; border-bottom-left-radius: 14px; }
                VerticalLayout {
                    padding-top: 22px;
                    padding-bottom: 22px;
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 0;
                    alignment: space-around;
                    LiveString { energy: root.s0; idle-color: #c28b56; }
                    LiveString { energy: root.s1; idle-color: #d0a578; }
                    LiveString { energy: root.s2; idle-color: #e0cba6; }
                    LiveString { energy: root.s3; idle-color: #dbe3e5; }
                    LiveString { energy: root.s4; idle-color: #e5ecee; }
                    LiveString { energy: root.s5; idle-color: #f1f5f6; }
                }
            }
        }

        Text {
            text: "Правая рука справа · проведи пальцем сквозь струну · резкий мах = бой";
            color: #9db5a8;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }
}

export component MusicPage inherits ScrollView {
    in property <int> instrument;
    in property <int> preset;
    in property <int> guitar-chord;
    in property <int> guitar-mode;
    in property <int> guitar-capo;
    in property <float> guitar-s0;
    in property <float> guitar-s1;
    in property <float> guitar-s2;
    in property <float> guitar-s3;
    in property <float> guitar-s4;
    in property <float> guitar-s5;
    in property <bool> muted;
    in property <float> volume;
    in property <float> sensitivity;
    in property <bool> camera-on;
    in property <bool> show-camera;
    in property <string> camera-status;
    in property <string> hand-status;
    in property <string> play-label;
    in property <string> play-hint;
    in property <float> fps;
    in property <image> frame;
    in property <image> play-frame;
    in property <bool> play-frame-ready;
    in property <[CameraRow]> cameras;
    in-out property <bool> immersive: false;

    callback start-camera();
    callback stop-camera();
    callback select-camera(int);
    callback refresh-cameras();
    callback open-camera-settings();
    callback set-play-mode(int);
    callback set-instrument(int);
    callback set-preset(int);
    callback set-guitar-chord(int);
    callback set-guitar-mode(int);
    callback set-guitar-capo(int);
    callback pluck-guitar-string(int);
    callback set-muted(bool);
    callback set-volume(float);
    callback set-sensitivity(float);
    callback set-show-camera(bool);
    callback set-immersive(bool);

    VerticalLayout {
        alignment: start;
        padding: root.immersive ? 10px : 28px;
        spacing: root.immersive ? 8px : 14px;

        if !root.immersive: PageTitle {
            mark: 4;
            title: "Инструменты";
            lead: "Пианино, барабаны, гитара и мелодия — лови шарики пальцами и собирай ноты.";
        }

        HorizontalLayout {
            spacing: 10px;
            Choice { label: "🎹 Фортепиано"; selected: root.instrument == 0; clicked => { root.set-instrument(0); } }
            Choice { label: "🥁 Барабаны"; selected: root.instrument == 1; clicked => { root.set-instrument(1); } }
            Choice { label: "🎸 Гитара"; selected: root.instrument == 2; clicked => { root.set-instrument(2); } }
            Choice { label: "🎵 Мелодия"; selected: root.instrument == 3; clicked => { root.set-instrument(3); } }
            Rectangle { horizontal-stretch: 1; }
            if !root.immersive: TextButton {
                label: "На весь экран";
                clicked => { root.immersive = true; root.set-immersive(true); }
            }
            if root.immersive: TextButton {
                label: "Свернуть";
                clicked => { root.immersive = false; root.set-immersive(false); }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Text { text: "Камера: " + root.camera-status; color: #64748b; font-size: 13px; vertical-alignment: center; }
            Rectangle { width: 1px; height: 16px; background: #cbd5e1; }
            Text { text: "Трекинг: " + root.hand-status; color: #64748b; font-size: 13px; vertical-alignment: center; }
            Rectangle { width: 1px; height: 16px; background: #cbd5e1; }
            Text { text: "" + Math.round(root.fps) + " FPS"; color: root.fps >= 24 ? #059669 : #d97706; font-size: 13px; font-weight: 700; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.play-label != "" && root.play-label != "—": Rectangle {
                background: #ecfdf5;
                border-radius: 8px;
                border-width: 1px;
                border-color: #a7f3d0;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 5px;
                    padding-bottom: 5px;
                    Text { text: root.play-label; color: #047857; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                }
            }
        }

        HorizontalLayout {
            spacing: root.immersive ? 0px : 18px;
            vertical-stretch: 1;
            Stage {
                height: root.immersive ? 820px : 520px;
                horizontal-stretch: 1;
                background: #0f172a;
                border-radius: root.immersive ? 0px : 12px;
                clip: true;

                // All instruments share play-frame (HUD + finger tracker). Falls back to clean camera / guitar scene.
                if root.play-frame-ready: Image {
                    source: root.play-frame;
                    width: 100%;
                    height: 100%;
                    image-fit: contain;
                }
                if !root.play-frame-ready && root.camera-on: Image {
                    source: root.frame;
                    width: 100%;
                    height: 100%;
                    image-fit: contain;
                }
                if !root.play-frame-ready && !root.camera-on && root.instrument == 2: GuitarScene {
                    width: 100%;
                    height: 100%;
                    chord: root.guitar-chord;
                    s0: root.guitar-s0;
                    s1: root.guitar-s1;
                    s2: root.guitar-s2;
                    s3: root.guitar-s3;
                    s4: root.guitar-s4;
                    s5: root.guitar-s5;
                    hit-label: root.play-label;
                }
                if !root.play-frame-ready && !root.camera-on && root.instrument != 2: Text {
                    text: "Включите камеру — появятся инструмент и трекер пальцев.";
                    color: #94a3b8;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                    wrap: word-wrap;
                }
            }

            if !root.immersive: Rectangle {
                width: 336px;
                background: #ffffff;
                border-radius: 12px;
                border-width: 1px;
                border-color: #e2e8f0;
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    Text { text: "Студия"; color: #0f172a; font-size: 18px; font-weight: 700; }

                    Rectangle {
                        background: #f8fafc;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #e2e8f0;
                        VerticalLayout {
                            padding: 10px;
                            Text { text: root.play-hint; color: #475569; font-size: 12px; wrap: word-wrap; }
                        }
                    }

                    if root.camera-on: TextButton { label: "Остановить камеру"; clicked => { root.stop-camera(); } }
                    if !root.camera-on: PrimaryButton { label: "Запустить камеру и играть"; clicked => { root.set-play-mode(1); root.start-camera(); } }

                    if root.cameras.length > 0: VerticalLayout {
                        spacing: 4px;
                        Text { text: "Камера"; color: #64748b; font-size: 12px; font-weight: 600; }
                        for camera in root.cameras: Choice {
                            label: camera.label;
                            selected: camera.selected;
                            clicked => { root.select-camera(camera.index); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Без звука"; color: #1e293b; vertical-alignment: center; font-size: 13px; }
                        Rectangle { horizontal-stretch: 1; }
                        Switch { checked: root.muted; toggled => { root.set-muted(self.checked); } }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Громкость " + Math.round(root.volume * 100) + "%"; color: #475569; font-size: 12px; }
                        Slider { minimum: 0; maximum: 1; value: root.volume; changed(value) => { root.set-volume(value); } }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Чувствительность " + Math.round(root.sensitivity * 100) + "%"; color: #475569; font-size: 12px; }
                        Slider { minimum: 0.4; maximum: 2.2; value: root.sensitivity; changed(value) => { root.set-sensitivity(value); } }
                    }

                    if root.instrument == 0: VerticalLayout {
                        spacing: 6px;
                        Text { text: "Тембр пианино"; color: #64748b; font-size: 12px; font-weight: 600; }
                        Choice { label: "Рояль"; selected: root.preset == 0; clicked => { root.set-preset(0); } }
                        Choice { label: "Яркое"; selected: root.preset == 1; clicked => { root.set-preset(1); } }
                        Choice { label: "Арфа"; selected: root.preset == 2; clicked => { root.set-preset(2); } }
                    }

                    if root.instrument == 1: VerticalLayout {
                        spacing: 6px;
                        Text { text: "УДАР"; color: #64748b; font-size: 11px; font-weight: 800; }
                        Text {
                            text: "На ладони — кружок. Наведи его на пэд и сожми кулак.\nБочка · Снейр · Хэт — семплы. На хэте открытая ладонь вниз — открытый хэт.";
                            color: #475569; font-size: 12px; wrap: word-wrap;
                        }
                    }

                    if root.instrument == 3: VerticalLayout {
                        spacing: 8px;
                        Text { text: "ТРЕК"; color: #64748b; font-size: 11px; font-weight: 800; }
                        Choice { label: "Звёздочка"; selected: root.preset == 0; clicked => { root.set-preset(0); } }
                        Choice { label: "Ода к радости"; selected: root.preset == 1; clicked => { root.set-preset(1); } }
                        Choice { label: "Ёлочка"; selected: root.preset == 2; clicked => { root.set-preset(2); } }
                        Choice { label: "Тетрис"; selected: root.preset == 3; clicked => { root.set-preset(3); } }
                        Choice { label: "День рождения"; selected: root.preset == 4; clicked => { root.set-preset(4); } }
                        Choice { label: "Jingle Bells"; selected: root.preset == 5; clicked => { root.set-preset(5); } }

                        Text { text: "СЛОЖНОСТЬ"; color: #64748b; font-size: 11px; font-weight: 800; }
                        HorizontalLayout {
                            spacing: 6px;
                            Choice { horizontal-stretch: 1; label: "Легко"; selected: root.guitar-mode == 0; clicked => { root.set-guitar-mode(0); } }
                            Choice { horizontal-stretch: 1; label: "Норм"; selected: root.guitar-mode == 1; clicked => { root.set-guitar-mode(1); } }
                            Choice { horizontal-stretch: 1; label: "Сложно"; selected: root.guitar-mode == 2; clicked => { root.set-guitar-mode(2); } }
                        }
                        Text {
                            text: "На ладони — полупрозрачный шарик. Коснись им цветной ноты — только так она сыграет. Само ничего не нажимается.";
                            color: #475569; font-size: 12px; wrap: word-wrap;
                        }
                    }

                    if root.instrument == 2: VerticalLayout {
                        spacing: 8px;

                        Text { text: "РЕЖИМ"; color: #64748b; font-size: 11px; font-weight: 800; }
                        HorizontalLayout {
                            spacing: 6px;
                            Choice { horizontal-stretch: 1; label: "Аккорды"; selected: root.guitar-mode == 0; clicked => { root.set-guitar-mode(0); } }
                            Choice { horizontal-stretch: 1; label: "Соло"; selected: root.guitar-mode == 1; clicked => { root.set-guitar-mode(1); } }
                        }

                        if root.guitar-mode == 0: VerticalLayout {
                            spacing: 5px;
                            Text { text: "АККОРД"; color: #64748b; font-size: 11px; font-weight: 800; }
                            HorizontalLayout {
                                spacing: 5px;
                                ChordPad { label: "Em"; selected: root.guitar-chord == 0; clicked => { root.set-guitar-chord(0); } }
                                ChordPad { label: "Am"; selected: root.guitar-chord == 1; clicked => { root.set-guitar-chord(1); } }
                                ChordPad { label: "C"; selected: root.guitar-chord == 2; clicked => { root.set-guitar-chord(2); } }
                                ChordPad { label: "G"; selected: root.guitar-chord == 3; clicked => { root.set-guitar-chord(3); } }
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                ChordPad { label: "D"; selected: root.guitar-chord == 4; clicked => { root.set-guitar-chord(4); } }
                                ChordPad { label: "A"; selected: root.guitar-chord == 5; clicked => { root.set-guitar-chord(5); } }
                                ChordPad { label: "E"; selected: root.guitar-chord == 6; clicked => { root.set-guitar-chord(6); } }
                                ChordPad { label: "F"; selected: root.guitar-chord == 7; clicked => { root.set-guitar-chord(7); } }
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                ChordPad { label: "Dm"; selected: root.guitar-chord == 8; clicked => { root.set-guitar-chord(8); } }
                                ChordPad { label: "Bm"; selected: root.guitar-chord == 9; clicked => { root.set-guitar-chord(9); } }
                                ChordPad { label: "Em7"; selected: root.guitar-chord == 10; clicked => { root.set-guitar-chord(10); } }
                                ChordPad { label: "Cadd9"; selected: root.guitar-chord == 11; clicked => { root.set-guitar-chord(11); } }
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                ChordPad { label: "Dsus4"; selected: root.guitar-chord == 12; clicked => { root.set-guitar-chord(12); } }
                                ChordPad { label: "Asus2"; selected: root.guitar-chord == 13; clicked => { root.set-guitar-chord(13); } }
                                ChordPad { label: "F#m"; selected: root.guitar-chord == 14; clicked => { root.set-guitar-chord(14); } }
                                ChordPad { label: "B7"; selected: root.guitar-chord == 15; clicked => { root.set-guitar-chord(15); } }
                            }
                        }
                        if root.guitar-mode == 1: Text {
                            text: "Левая рука ставит лад. Правая щипает или делает бой.";
                            color: #475569; font-size: 12px; wrap: word-wrap;
                        }

                        Text { text: "ЩИПОК · тест звука"; color: #64748b; font-size: 11px; font-weight: 800; }
                        HorizontalLayout {
                            spacing: 5px;
                            GuitarStringPad { label: "6 E2"; energy: root.guitar-s0; clicked => { root.pluck-guitar-string(0); } }
                            GuitarStringPad { label: "5 A2"; energy: root.guitar-s1; clicked => { root.pluck-guitar-string(1); } }
                            GuitarStringPad { label: "4 D3"; energy: root.guitar-s2; clicked => { root.pluck-guitar-string(2); } }
                        }
                        HorizontalLayout {
                            spacing: 5px;
                            GuitarStringPad { label: "3 G3"; energy: root.guitar-s3; clicked => { root.pluck-guitar-string(3); } }
                            GuitarStringPad { label: "2 B3"; energy: root.guitar-s4; clicked => { root.pluck-guitar-string(4); } }
                            GuitarStringPad { label: "1 E4"; energy: root.guitar-s5; clicked => { root.pluck-guitar-string(5); } }
                        }

                        VerticalLayout {
                            spacing: 3px;
                            Text { text: "Каподастр · лад " + root.guitar-capo; color: #475569; font-size: 12px; }
                            Slider { minimum: 0; maximum: 7; value: root.guitar-capo; changed(value) => { root.set-guitar-capo(Math.round(value)); } }
                        }

                        Text { text: "ТЕМБР"; color: #64748b; font-size: 11px; font-weight: 800; }
                        HorizontalLayout {
                            spacing: 5px;
                            Choice { horizontal-stretch: 1; label: "Acoustic"; selected: root.preset == 0; clicked => { root.set-preset(0); } }
                            Choice { horizontal-stretch: 1; label: "Clean"; selected: root.preset == 1; clicked => { root.set-preset(1); } }
                        }
                        HorizontalLayout {
                            spacing: 5px;
                            Choice { horizontal-stretch: 1; label: "Crunch"; selected: root.preset == 2; clicked => { root.set-preset(2); } }
                            Choice { horizontal-stretch: 1; label: "Lead"; selected: root.preset == 3; clicked => { root.set-preset(3); } }
                            Choice { horizontal-stretch: 1; label: "Bass"; selected: root.preset == 4; clicked => { root.set-preset(4); } }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Камера PiP"; color: #1e293b; vertical-alignment: center; font-size: 13px; }
                            Rectangle { horizontal-stretch: 1; }
                            Switch { checked: root.show-camera; toggled => { root.set-show-camera(self.checked); } }
                        }
                    }

                    if root.instrument != 2: HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Камера на заднем плане"; color: #1e293b; vertical-alignment: center; font-size: 13px; }
                        Rectangle { horizontal-stretch: 1; }
                        Switch { checked: root.show-camera; toggled => { root.set-show-camera(self.checked); } }
                    }
                }
            }
        }
    }
}
