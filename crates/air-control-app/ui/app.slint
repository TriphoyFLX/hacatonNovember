import { ScrollView, Slider, Switch, ComboBox, LineEdit, Palette } from "std-widgets.slint";
import { CameraRow, Choice, Fade, GestureCard, GestureRow, Lesson, NavItem, PageTitle, PrimaryButton, ProfileRow, SheetRow, Stage, TextButton } from "components.slint";
import { MusicPage } from "music_page.slint";

export component AppWindow inherits Window {
    title: "AIR CONTROL";
    icon: @image-url("icon.png");
    default-font-family: "Segoe UI";
    default-font-size: 15px;
    min-width: 1080px;
    min-height: 700px;
    preferred-width: 1240px;
    preferred-height: 800px;
    background: #f6f3ee;

    init => {
        Palette.color-scheme = ColorScheme.light;
    }

    in-out property <int> page: 0;
    changed page => {
        if (root.page == 10) {
            root.set-play-mode(root.play-mode);
        }
        if (root.page == 11) {
            root.set-play-mode(1);
        }
    }
    in-out property <string> version: "0.9.0";
    in-out property <string> system-status: "Ожидание";
    in-out property <string> camera-status: "Камера выключена";
    in-out property <string> hand-status: "Рука не видна";
    in-out property <string> gesture-name: "—";
    in-out property <float> confidence: 0;
    in-out property <string> command-name: "—";
    in-out property <string> command-status: "ожидание";
    in-out property <string> rejection: "";
    in-out property <string> profile-name: "Рабочий стол";
    in-out property <string> context-line: "";
    in-out property <float> fps: 0;
    in-out property <float> latency-ms: 0;
    in-out property <float> capture-ms: 0;
    in-out property <float> inference-ms: 0;
    in-out property <float> ipc-ms: 0;
    in-out property <float> gesture-ms: 0;
    in-out property <float> dispatch-ms: 0;
    in-out property <bool> control-on: false;
    in-out property <bool> camera-on: false;
    changed camera-on => {
        if (root.camera-on && root.page == 10 && root.play-mode == 0) {
            root.set-play-mode(0);
        }
    }
    in-out property <bool> paused: false;
    in-out property <bool> ipc-ok: false;
    in-out property <float> cpu: 0;
    in-out property <float> ram-mb: 0;
    in-out property <int> vision-pid: 0;
    in-out property <string> error-text: "";
    in-out property <string> calibration-title: "";
    in-out property <string> calibration-hint: "";
    in-out property <float> calibration-progress: 0;
    in-out property <bool> calibration-active: false;
    in-out property <string> coach-line: "";
    in-out property <string> tracking-health: "трекинг в норме";
    in-out property <bool> dwell-click: false;
    in-out property <bool> session-recording: false;
    in-out property <int> stats-gestures: 0;
    in-out property <int> stats-commands: 0;
    in-out property <int> stats-clicks: 0;
    in-out property <int> stats-scrolls: 0;
    in-out property <int> stats-rejected: 0;
    in-out property <int> stats-reconnects: 0;
    in-out property <int> stats-uptime: 0;
    in-out property <string> log-text: "";
    in-out property <bool> show-camera: true;
    in-out property <bool> mirror: true;
    in-out property <bool> auto-context: true;
    in-out property <bool> air-keyboard: false;
    in-out property <int> play-mode: 0;
    in-out property <int> play-instrument: 0;
    in-out property <int> play-element: 0;
    in-out property <int> play-brush: 0;
    in-out property <int> play-color: 3;
    in-out property <int> play-preset: 0;
    in-out property <int> play-guitar-chord: 0;
    in-out property <int> play-guitar-mode: 0;
    in-out property <int> play-guitar-capo: 0;
    in-out property <bool> play-muted: false;
    in-out property <float> play-volume: 0.8;
    in-out property <float> play-sensitivity: 1;
    in-out property <float> play-thickness: 5.5;
    in-out property <float> play-fade: 0.045;
    in-out property <string> play-label: "—";
    in-out property <string> play-hint: "";
    in-out property <float> speed: 1.2;
    in-out property <float> smoothness: 0.45;
    in-out property <float> acceleration: 0.35;
    in-out property <float> deadzone: 2;
    in-out property <float> confidence-threshold: 0.72;
    in-out property <int> quality-index: 1;
    in-out property <int> hand-index: 0;
    in-out property <int> sensitivity-index: 1;
    in-out property <string> selected-gesture: "";
    in-out property <image> frame;
    in-out property <[GestureRow]> gestures;
    in-out property <[CameraRow]> cameras;
    in-out property <[ProfileRow]> profiles;
    in-out property <[string]> command-choices;

    callback start-camera();
    callback stop-camera();
    callback set-control(bool);
    callback toggle-pause();
    callback emergency-stop();
    callback select-camera(int);
    callback select-profile(string);
    callback set-auto-context(bool);
    callback set-air-keyboard(bool);
    callback set-dwell-click(bool);
    callback toggle-session-record();
    callback set-show-camera(bool);
    callback set-mirror(bool);
    callback set-quality(int);
    callback set-hand(int);
    callback set-sens-profile(int);
    callback set-speed(float);
    callback set-smoothness(float);
    callback set-acceleration(float);
    callback set-deadzone(float);
    callback set-confidence(float);
    callback calibration-start();
    callback calibration-next();
    callback calibration-cancel();
    callback calibration-drill();
    callback record-gesture(string, float);
    callback delete-gesture(string);
    callback assign-command(string, string);
    callback export-gestures();
    callback import-gestures();
    callback open-logs();
    callback refresh-cameras();
    callback open-camera-settings();
    callback set-play-mode(int);
    callback set-play-instrument(int);
    callback set-play-element(int);
    callback set-play-brush(int);
    callback set-play-color(int);
    callback set-play-preset(int);
    callback set-guitar-chord(int);
    callback set-guitar-mode(int);
    callback set-guitar-capo(int);
    callback pluck-guitar-string(int);
    callback set-play-muted(bool);
    callback set-play-volume(float);
    callback set-play-sensitivity(float);
    callback set-play-thickness(float);
    callback set-play-fade(float);
    callback clear-art();

    pure function situation() -> string {
        if root.error-text != "" { root.error-text }
        else if root.paused { "Пауза. Обычная мышь снова работает. Чтобы продолжить, нажмите «Продолжить»." }
        else if root.play-mode != 0 && !root.camera-on { "Сцена выбрана. Сначала включите камеру — мышь останется вашей." }
        else if root.play-mode != 0 { root.play-hint }
        else if !root.camera-on && root.camera-status == "Камера не найдена" { "Камера не найдена. Разрешите доступ в параметрах системы или нажмите «Проверить ещё раз»." }
        else if !root.camera-on && root.cameras.length > 0 { "Камера найдена, но картинка ещё выключена. Ничего не записывается." }
        else if !root.camera-on { root.camera-status }
        else if !root.control-on { "Камера включена. Курсор пока двигается только обычной мышью." }
        else { "Указательный палец двигает курсор. Короткий щипок — щелчок. Чтобы прокрутить, раскройте ладонь и резко взмахните." }
    }

    HorizontalLayout {
        spacing: 0;
        Rectangle {
            width: 232px;
            background: #efeae2;
            VerticalLayout {
                padding: 28px;
                padding-top: 32px;
                spacing: 2px;
                Text { text: "Air Control"; color: #1c1915; font-size: 18px; font-weight: 600; }
                Text { text: "Мышь без прикосновения"; color: #6d655c; font-size: 12px; }
                Rectangle { height: 28px; }
                NavItem { mark: 0; label: "С чего начать"; active: root.page == 0; clicked => { root.page = 0; } }
                NavItem { mark: 7; label: "Моя рука"; active: root.page == 1; clicked => { root.page = 1; } }
                NavItem { mark: 1; label: "Что умеет рука"; active: root.page == 4; clicked => { root.page = 4; } }
                NavItem { mark: 4; label: "Сцена"; active: root.page == 10; clicked => { root.page = 10; } }
                NavItem { mark: 4; label: "Музыкальные инструменты"; active: root.page == 11; clicked => { root.page = 11; } }
                Rectangle { height: 18px; }
                Text { text: "Когда освоитесь"; color: #8a8176; font-size: 12px; }
                Rectangle { height: 6px; }
                NavItem { mark: 8; label: "Подстроить руку"; quiet: true; active: root.page == 3; clicked => { root.page = 3; } }
                NavItem { mark: 9; label: "Свои движения"; quiet: true; active: root.page == 2; clicked => { root.page = 2; } }
                NavItem { mark: 2; label: "Разные программы"; quiet: true; active: root.page == 5; clicked => { root.page = 5; } }
                NavItem { mark: 3; label: "Камера"; quiet: true; active: root.page == 7; clicked => { root.page = 7; } }
                NavItem { mark: 10; label: "Если не работает"; quiet: true; active: root.page == 8 || root.page == 6; clicked => { root.page = 8; } }
                NavItem { mark: 11; label: "О программе"; quiet: true; active: root.page == 9; clicked => { root.page = 9; } }
                Rectangle { vertical-stretch: 1; }
                Text { text: "Остановить в любой момент"; color: #8a8176; font-size: 12px; wrap: word-wrap; }
                Text { text: "Ctrl + Shift + F12"; color: #1c1915; font-size: 13px; }
            }
        }

        VerticalLayout {
            spacing: 0;
            Rectangle {
                vertical-stretch: 1;
                if root.page == 0: HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 56px;
                    spacing: 56px;
                    alignment: center;
                    cross-axis-alignment: center;
                    VerticalLayout {
                        alignment: start;
                        spacing: 16px;
                        min-width: 380px;
                        max-width: 460px;
                        Text {
                            text: root.camera-status == "Камера не найдена" ? "Камера не найдена" : (!root.camera-on ? (root.cameras.length > 0 ? "Камера на месте" : "Сначала включите камеру") : (!root.control-on ? "Камера вас видит?" : "Рука вместо мыши"));
                            color: #1c1915;
                            font-size: 40px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        Text {
                            text: !root.camera-on ? (root.cameras.length > 0 ? "Кнопка включает картинку. Курсор останется у мыши, пока вы сами его не отдадите. Картинка не уходит с компьютера." : root.camera-status) : (!root.control-on ? "На картинке справа должна появиться линия по пальцам. Если она есть, можно отдать курсор указательному пальцу." : "Ведите кончиком указательного. Короткий щипок нажимает там, где стоит курсор. Обычная мышь тоже работает.");
                            color: #5e574e;
                            font-size: 16px;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 8px; }
                        if !root.camera-on: PrimaryButton { cross-axis-self-alignment: start; label: "Включить камеру"; clicked => { root.start-camera(); } }
                        if !root.camera-on && root.camera-status == "Камера не найдена": TextButton { cross-axis-self-alignment: start; label: "Проверить ещё раз"; clicked => { root.refresh-cameras(); } }
                        if !root.camera-on && root.camera-status == "Камера не найдена": TextButton { cross-axis-self-alignment: start; label: "Параметры камеры"; clicked => { root.open-camera-settings(); } }
                        if root.camera-on && !root.control-on: PrimaryButton { cross-axis-self-alignment: start; label: "Двигать курсор пальцем"; clicked => { root.set-control(true); } }
                        if root.control-on && !root.paused: TextButton { cross-axis-self-alignment: start; label: "Вернуть обычную мышь"; danger: true; clicked => { root.emergency-stop(); } }
                        if root.paused: PrimaryButton { cross-axis-self-alignment: start; label: "Продолжить"; clicked => { root.toggle-pause(); } }
                        if root.camera-on: TextButton { cross-axis-self-alignment: start; label: "Выключить камеру"; clicked => { root.stop-camera(); } }
                        if root.control-on && !root.paused: VerticalLayout {
                            alignment: start;
                            spacing: 0;
                            Lesson { hand: "Указательный палец"; does: "курсор"; }
                            Lesson { hand: "Щипок"; does: "клик"; }
                            Lesson { hand: "Щипок и движение"; does: "перетащить"; }
                            Lesson { hand: "Раскрытая ладонь, резкий взмах"; does: "прокрутка"; }
                        }
                    }
                    Rectangle { width: 1px; height: 240px; background: #d5cdc2; }
                    VerticalLayout {
                        width: 300px;
                        alignment: start;
                        spacing: 0;
                        if !root.camera-on: VerticalLayout {
                            alignment: start;
                            spacing: 0;
                            Text { text: "Что уже готово"; color: #8a8176; font-size: 13px; }
                            Rectangle { height: 16px; }
                            Text { text: root.cameras.length > 0 ? "●  Камера найдена" : "○  Камера найдена"; color: root.cameras.length > 0 ? #1c1915 : #8a8176; font-size: 16px; }
                            if root.cameras.length == 1: VerticalLayout {
                                for camera in root.cameras: Text { text: camera.label; color: #1f4d3a; font-size: 15px; }
                            }
                            if root.cameras.length > 1: VerticalLayout {
                                spacing: 6px;
                                for camera in root.cameras: Choice {
                                    label: camera.label;
                                    selected: camera.selected;
                                    clicked => { root.select-camera(camera.index); }
                                }
                            }
                            Rectangle { height: 12px; }
                            Text { text: "○  Картинка включена"; color: #8a8176; font-size: 16px; }
                            Rectangle { height: 12px; }
                            Text { text: "○  Рука в кадре"; color: #8a8176; font-size: 16px; }
                            Rectangle { height: 12px; }
                            Text { text: "○  Курсор отдан пальцу"; color: #8a8176; font-size: 16px; }
                            Rectangle { height: 18px; }
                            Text { text: "Картинка включится только по кнопке. До этого программа знает лишь имя камеры."; color: #5e574e; font-size: 13px; wrap: word-wrap; }
                        }
                        if root.camera-on: VerticalLayout {
                            alignment: start;
                            spacing: 10px;
                            Rectangle {
                                height: 280px;
                                background: #1c1915;
                                if root.show-camera: Image { source: root.frame; width: 100%; height: 100%; image-fit: contain; }
                                if !root.show-camera: Text { text: "Картинка скрыта. Линия руки всё ещё считается."; color: #f6f3ee; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; wrap: word-wrap; }
                            }
                            Text { text: root.hand-status; color: #1c1915; font-size: 16px; }
                            Text { text: root.gesture-name == "—" ? "Покажите ладонь внутри рамки." : root.gesture-name; color: #1f4d3a; font-size: 28px; font-weight: 600; wrap: word-wrap; }
                            Text { text: root.control-on ? root.command-name : "Курсор ещё слушает обычную мышь."; color: #5e574e; font-size: 14px; wrap: word-wrap; }
                            if root.coach-line != "": Text { text: root.coach-line; color: #8a4b12; font-size: 13px; wrap: word-wrap; }
                        }
                    }
                }

                if root.page == 1: HorizontalLayout {
                    padding: 40px;
                    spacing: 36px;
                    VerticalLayout {
                        alignment: start;
                        width: 300px;
                        spacing: 14px;
                        PageTitle { mark: 7; title: "Моя рука"; lead: "Курсор повторяет кончик указательного пальца. Сожмите большой и указательный, чтобы нажать."; }
                        Fade {
                            delay-ms: 60;
                            gap: 14px;
                            Text { text: root.hand-status; color: #1f4d3a; font-size: 16px; wrap: word-wrap; }
                            HorizontalLayout {
                                Text { text: "Показывать картинку"; color: #1c1915; vertical-alignment: center; }
                                Switch { checked: root.show-camera; toggled => { root.set-show-camera(self.checked); } }
                            }
                            HorizontalLayout {
                                Text { text: "Как в зеркале"; color: #1c1915; vertical-alignment: center; }
                                Switch { checked: root.mirror; toggled => { root.set-mirror(self.checked); } }
                            }
                            Text { text: "Зеркало включено, если рука вправо двигает курсор вправо."; color: #8a8176; font-size: 13px; wrap: word-wrap; }
                            if !root.camera-on: PrimaryButton { cross-axis-self-alignment: start; label: "Включить камеру"; clicked => { root.start-camera(); } }
                            if root.camera-on: TextButton { cross-axis-self-alignment: start; label: "Выключить камеру"; clicked => { root.stop-camera(); } }
                        }
                    }
                    Stage {
                        delay-ms: 120;
                        background: #1c1915;
                        if root.camera-on: Image { source: root.frame; width: 100%; height: 100%; image-fit: contain; }
                        if !root.camera-on: Text { text: "Здесь появится ваша рука."; color: #f6f3ee; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                    }
                }

                if root.page == 4: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 48px;
                        spacing: 22px;
                        PageTitle { title: "Что умеет рука"; lead: "Повторяйте движение по серой строке. Зелёная строка — что произойдёт."; }
                        Text { text: "С чего начать"; color: #1c1915; font-size: 18px; font-weight: 600; }
                        Text { text: "Включите камеру. Откройте «Сцену» и выберите «Курсор». Поднимите один указательный палец: курсор поедет за ним."; color: #5e574e; wrap: word-wrap; }
                        Text { text: "Мышь"; color: #1c1915; font-size: 18px; font-weight: 600; }
                        GridLayout {
                            spacing: 12px;
                            GestureCard { row: 0; col: 0; delay-ms: 0; mark: 0; hand: "Указательный палец"; does: "Курсор"; how: "Выпрямите его. Остальные пальцы подогните."; }
                            GestureCard { row: 0; col: 1; delay-ms: 40; mark: 1; hand: "Щипок"; does: "Один клик"; how: "Коснитесь большим кончика указательного и держите руку на месте."; }
                            GestureCard { row: 1; col: 0; delay-ms: 80; mark: 7; hand: "Щипок и сдвиг"; does: "Перетащить"; how: "Сожмите, чуть подержите, потом сдвиньте руку не разжимая. Отпустите, чтобы бросить."; }
                            GestureCard { row: 1; col: 1; delay-ms: 120; mark: 12; hand: "Два щипка"; does: "Двойной клик"; how: "Щипок, разожмите, и сразу ещё раз на том же месте."; }
                            GestureCard { row: 2; col: 0; delay-ms: 160; mark: 2; hand: "Буква V"; does: "Правый клик"; how: "Указательный и средний врозь, остальные в кулаке. Подержите."; }
                            GestureCard { row: 2; col: 1; delay-ms: 200; mark: 14; hand: "Открытая ладонь"; does: "Страница и стол"; how: "Проведите ладонь прямо. Вверх и вниз листают, влево и вправо меняют стол."; }
                            GestureCard { row: 3; col: 0; delay-ms: 240; mark: 8; hand: "Большой палец вверх"; does: "Громче"; how: "Кулак, большой выше остальных. Кончика указательного не касайтесь."; }
                            GestureCard { row: 3; col: 1; delay-ms: 280; mark: 15; hand: "Большой палец вниз"; does: "Тише"; how: "Тот же кулак, большой палец вниз. Подержите."; }
                        }
                        Text { text: "Две руки"; color: #1c1915; font-size: 18px; font-weight: 600; }
                        GridLayout {
                            spacing: 12px;
                            GestureCard { row: 0; col: 0; delay-ms: 300; mark: 5; hand: "Две ладони"; does: "Масштаб"; how: "Разведите руки — крупнее. Сведите — мельче."; }
                            GestureCard { row: 0; col: 1; delay-ms: 340; mark: 7; hand: "Две ладони в сторону"; does: "Другой стол"; how: "Обе открытые ладони ведите в одну сторону."; }
                        }
                        Text { text: "Сцена"; color: #1c1915; font-size: 18px; font-weight: 600; }
                        Text { text: "Музыка, магия и рисунок не двигают мышь. Сначала выберите их на странице «Сцена»."; color: #5e574e; wrap: word-wrap; }
                        GridLayout {
                            spacing: 12px;
                            GestureCard { row: 0; col: 0; delay-ms: 360; mark: 4; hand: "Пианино"; does: "Нота"; how: "Опустите палец на нижний ряд. Две руки вверх меняют инструмент."; }
                            GestureCard { row: 0; col: 1; delay-ms: 400; mark: 14; hand: "Барабаны"; does: "Удар"; how: "Ударьте ладонью или пальцем по кругу."; }
                            GestureCard { row: 1; col: 0; delay-ms: 440; mark: 6; hand: "Гитара"; does: "Струна"; how: "Слева ладонь выбирает аккорд. Справа проведите пальцем по струнам."; }
                            GestureCard { row: 1; col: 1; delay-ms: 480; mark: 5; hand: "Магия"; does: "Эффект"; how: "Кулак — заряд. Щипок — струя. Раскройте кулак — вспышка."; }
                            GestureCard { row: 2; col: 0; delay-ms: 520; mark: 6; hand: "Рисунок"; does: "Линия"; how: "Открытая ладонь или палец рисуют. Кулак переносит руку без следа."; }
                        }
                        Text { text: "В браузере ладонь в сторону листает вкладки, в музыке — треки. Само движение то же."; color: #8a8176; font-size: 13px; wrap: word-wrap; }
                        Fade {
                            delay-ms: 380;
                            gap: 0px;
                            Rectangle {
                            background: #fffcf8;
                            border-width: 1px;
                            border-color: #e4dcd2;
                            VerticalLayout {
                                padding: 22px;
                                spacing: 12px;
                                Text { text: "Если курсор слишком резкий или слишком сонный"; color: #1c1915; font-size: 18px; font-weight: 600; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Choice { label: "Точнее"; selected: root.sensitivity-index == 0; clicked => { root.set-sens-profile(0); } }
                                    Choice { label: "Обычно"; selected: root.sensitivity-index == 1; clicked => { root.set-sens-profile(1); } }
                                    Choice { label: "Быстрее"; selected: root.sensitivity-index == 2; clicked => { root.set-sens-profile(2); } }
                                }
                                Text { text: "Насколько далеко уезжает курсор"; color: #5e574e; }
                                Slider { minimum: 0.6; maximum: 2.2; value: root.speed; changed(value) => { root.set-speed(value); } }
                                Text { text: "Насколько сглаживать дрожь. Правее — спокойнее."; color: #5e574e; wrap: word-wrap; }
                                Slider { minimum: 0; maximum: 1; value: root.smoothness; changed(value) => { root.set-smoothness(value); } }
                                Text { text: "Лёгкий разгон быстрого взмаха"; color: #5e574e; wrap: word-wrap; }
                                Slider { minimum: 0; maximum: 1; value: root.acceleration; changed(value) => { root.set-acceleration(value); } }
                                Text { text: "Мелкая дрожь, пиксели: " + Math.round(root.deadzone); color: #5e574e; }
                                Slider { minimum: 0; maximum: 12; value: root.deadzone; changed(value) => { root.set-deadzone(value); } }
                                Text { text: "Насколько уверенной должна быть рука для щелчка"; color: #5e574e; wrap: word-wrap; }
                                Slider { minimum: 0.4; maximum: 0.95; value: root.confidence-threshold; changed(value) => { root.set-confidence(value); } }
                            }
                            }
                        }
                    }
                }

                if root.page == 2: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 40px;
                        spacing: 12px;
                        PageTitle { mark: 9; title: "Свои движения"; lead: "Покажите движение один раз. Потом выберите, что оно делает: клавишу, окно или громкость. Это запомненный образец, не обучение."; }
                        Fade {
                            delay-ms: 50;
                            gap: 12px;
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                name-field := LineEdit { placeholder-text: "Как назвать движение"; horizontal-stretch: 1; min-width: 240px; }
                                PrimaryButton { cross-axis-self-alignment: start; label: "Запомнить"; clicked => { root.record-gesture(name-field.text, 0.55); } }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                commands := ComboBox { model: root.command-choices; horizontal-stretch: 1; min-width: 240px; }
                                TextButton { cross-axis-self-alignment: start; label: "Назначить выбранному"; clicked => { root.assign-command(root.selected-gesture, commands.current-value); } }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 16px;
                                TextButton { cross-axis-self-alignment: start; label: "Удалить"; clicked => { root.delete-gesture(root.selected-gesture); } }
                                TextButton { cross-axis-self-alignment: start; label: "Сохранить в файл"; clicked => { root.export-gestures(); } }
                                TextButton { cross-axis-self-alignment: start; label: "Открыть из файла"; clicked => { root.import-gestures(); } }
                            }
                            Text { text: root.selected-gesture == "" ? "Нажмите на строку, чтобы выбрать движение." : "Выбрано: " + root.selected-gesture; color: #5e574e; }
                        }
                        for gesture[i] in root.gestures: SheetRow {
                            delay-ms: 120 + i * 60;
                            mark: gesture.custom ? 9 : 1;
                            title: gesture.title;
                            detail: gesture.command;
                            on: root.selected-gesture == gesture.id;
                            clicked => { root.selected-gesture = gesture.id; }
                        }
                    }
                }

                if root.page == 3: HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 40px;
                    spacing: 28px;
                    VerticalLayout {
                        alignment: start;
                        width: 400px;
                        spacing: 14px;
                        PageTitle { mark: 8; title: "Подстроить под вашу руку"; lead: root.calibration-hint; }
                        Text { text: root.calibration-title; color: #1f4d3a; font-size: 18px; wrap: word-wrap; }
                        Rectangle {
                            height: 4px;
                            background: #e5ddd2;
                            Rectangle {
                                height: 4px;
                                width: parent.width * root.calibration-progress;
                                background: #1f4d3a;
                                animate width { duration: 240ms; easing: ease-out; }
                            }
                        }
                        Text { text: "Зелёная строка — текущий шаг. После зоны идут проверка и тренировка щипка. Справа видно кадр. Курсор остаётся у мыши."; color: #1c1915; wrap: word-wrap; }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 12px;
                            if !root.calibration-active: PrimaryButton { cross-axis-self-alignment: start; label: "Начать"; clicked => { if (!root.camera-on) { root.start-camera(); } root.calibration-start(); } }
                            if root.calibration-active: PrimaryButton { cross-axis-self-alignment: start; label: "Дальше"; clicked => { root.calibration-next(); } }
                            if root.calibration-active: TextButton { cross-axis-self-alignment: start; label: "Отмена"; clicked => { root.calibration-cancel(); } }
                            if !root.calibration-active: TextButton { cross-axis-self-alignment: start; label: "Тренировка щипка"; clicked => { if (!root.camera-on) { root.start-camera(); } root.calibration-drill(); } }
                        }
                        Text { text: root.camera-on ? root.hand-status : "Камера включится по кнопке «Начать»."; color: #1c1915; font-size: 15px; wrap: word-wrap; }
                        Text { text: root.camera-on ? (root.gesture-name == "—" ? "Покажите руку в кадре." : root.gesture-name) : ""; color: #1f4d3a; font-size: 22px; font-weight: 600; wrap: word-wrap; }
                        if root.coach-line != "": Text { text: root.coach-line; color: #8a4b12; font-size: 14px; wrap: word-wrap; }
                        if root.camera-on && !root.show-camera: TextButton { cross-axis-self-alignment: start; label: "Показать картинку"; clicked => { root.set-show-camera(true); } }
                    }
                    Stage {
                        delay-ms: 0;
                        background: #1c1915;
                        min-width: 420px;
                        if root.camera-on && root.show-camera: Image { source: root.frame; width: 100%; height: 100%; image-fit: contain; }
                        if root.camera-on && !root.show-camera: Text { text: "Картинка скрыта. Включите показ, чтобы видеть руку."; color: #f6f3ee; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; wrap: word-wrap; }
                        if !root.camera-on: Text { text: "Нажмите «Начать» — здесь появится ваша рука."; color: #f6f3ee; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; wrap: word-wrap; }
                    }
                }

                if root.page == 5: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 40px;
                        spacing: 12px;
                        PageTitle { mark: 2; title: "Разные программы"; lead: "Одни и те же движения могут листать презентацию, вкладки или музыку. Программа смотрит на имя открытого приложения и пишет его ниже."; }
                        Fade {
                            delay-ms: 40;
                            gap: 12px;
                            Text { text: root.context-line; color: #1c1915; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Менять набор само, по открытой программе"; color: #1c1915; vertical-alignment: center; }
                                Switch { checked: root.auto-context; toggled => { root.set-auto-context(self.checked); } }
                            }
                        }
                        for profile[i] in root.profiles: SheetRow {
                            delay-ms: 100 + i * 60;
                            mark: profile.mark;
                            title: profile.title;
                            detail: profile.active ? "сейчас" : "";
                            on: profile.active;
                            clicked => { root.select-profile(profile.id); }
                        }
                        Fade {
                            delay-ms: 280;
                            gap: 12px;
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Режим клавиш: Enter, Escape, стрелки, копировать и вставить"; color: #1c1915; vertical-alignment: center; wrap: word-wrap; }
                                Switch { checked: root.air-keyboard; toggled => { root.set-air-keyboard(self.checked); } }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Клик удержанием: держите указательный ~0.6 с"; color: #1c1915; vertical-alignment: center; wrap: word-wrap; }
                                Switch { checked: root.dwell-click; toggled => { root.set-dwell-click(self.checked); } }
                            }
                            Text { text: "Сейчас набор: " + root.profile-name; color: #5e574e; }
                        }
                    }
                }

                if root.page == 7: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 40px;
                        spacing: 14px;
                        PageTitle { mark: 3; title: "Камера"; lead: "Выберите баланс между плавностью, детализацией и нагрузкой на компьютер."; }
                        Fade {
                            delay-ms: 50;
                            gap: 14px;
                        Text { text: "Картинка"; color: #1c1915; }
                        HorizontalLayout {
                            spacing: 8px;
                            Choice { label: "Легче для компьютера"; selected: root.quality-index == 0; clicked => { root.set-quality(0); } }
                            Choice { label: "Обычно"; selected: root.quality-index == 1; clicked => { root.set-quality(1); } }
                            Choice { label: "Подробнее"; selected: root.quality-index == 2; clicked => { root.set-quality(2); } }
                        }
                        Text { text: "Лёгкий режим — 20 FPS, обычный — 24 FPS. «Подробнее» использует 30 FPS и больше ресурсов."; color: #5e574e; wrap: word-wrap; }
                        Text { text: "Ведущая рука"; color: #1c1915; }
                        HorizontalLayout {
                            spacing: 8px;
                            Choice { label: "Правая"; selected: root.hand-index == 0; clicked => { root.set-hand(0); } }
                            Choice { label: "Левая"; selected: root.hand-index == 1; clicked => { root.set-hand(1); } }
                            Choice { label: "Любая"; selected: root.hand-index == 2; clicked => { root.set-hand(2); } }
                        }
                        Text { text: "Если камер несколько, выберите свою"; color: #1c1915; }
                        for camera in root.cameras: Choice {
                            label: camera.label;
                            selected: camera.selected;
                            clicked => { root.select-camera(camera.index); }
                        }
                        Text { text: root.cameras.length == 0 ? root.camera-status : "Выбранная камера отмечена."; color: #5e574e; wrap: word-wrap; }
                        TextButton { cross-axis-self-alignment: start; label: "Проверить ещё раз"; clicked => { root.refresh-cameras(); } }
                        TextButton { cross-axis-self-alignment: start; label: "Параметры камеры"; clicked => { root.open-camera-settings(); } }
                        }
                    }
                }

                if root.page == 8 || root.page == 6: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 40px;
                        spacing: 10px;
                        PageTitle { mark: 10; title: "Если не работает"; lead: "Сначала верните обычную мышь. Потом прочитайте, что видит программа."; }
                        Fade {
                            delay-ms: 50;
                            gap: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                background: #fffcf8;
                                border-width: 1px;
                                border-color: #e5ddd2;
                                height: 72px;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 12px;
                                    alignment: center;
                                    Text { text: "" + root.stats-clicks; color: #1c1915; font-size: 22px; font-weight: 600; }
                                    Text { text: "щелчков"; color: #8a8176; font-size: 12px; }
                                }
                            }
                            Rectangle {
                                background: #fffcf8;
                                border-width: 1px;
                                border-color: #e5ddd2;
                                height: 72px;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 12px;
                                    alignment: center;
                                    Text { text: "" + root.stats-scrolls; color: #1c1915; font-size: 22px; font-weight: 600; }
                                    Text { text: "прокруток"; color: #8a8176; font-size: 12px; }
                                }
                            }
                            Rectangle {
                                background: #fffcf8;
                                border-width: 1px;
                                border-color: #e5ddd2;
                                height: 72px;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 12px;
                                    alignment: center;
                                    Text { text: "" + Math.round(root.fps); color: #1c1915; font-size: 22px; font-weight: 600; }
                                    Text { text: "кадров/с"; color: #8a8176; font-size: 12px; }
                                }
                            }
                        }
                        TextButton { cross-axis-self-alignment: start; label: "Вернуть обычную мышь"; danger: true; clicked => { root.emergency-stop(); } }
                        Text { text: "Здоровье трекинга: " + root.tracking-health; color: #1c1915; wrap: word-wrap; }
                        Text { text: "Камера: " + root.camera-status; color: #1c1915; wrap: word-wrap; }
                        Text { text: "Рука: " + root.hand-status; color: #1c1915; wrap: word-wrap; }
                        Text { text: root.rejection == "" ? "Жест не отклонён." : "Почему жест не сработал: " + root.rejection; color: #1c1915; wrap: word-wrap; }
                        if root.coach-line != "": Text { text: root.coach-line; color: #8a4b12; wrap: word-wrap; }
                        Text { text: "Кадров в секунду " + Math.round(root.fps) + ". От картинки до действия около " + Math.round(root.latency-ms) + " мс. Это замер этой минуты."; color: #5e574e; wrap: word-wrap; }
                        Text { text: "Связь с камерой: " + (root.ipc-ok ? "есть" : "нет") + ". Загрузка процессора " + Math.round(root.cpu) + "%, память " + Math.round(root.ram-mb) + " МБ."; color: #5e574e; wrap: word-wrap; }
                        Text { text: "За сессию: жестов " + root.stats-gestures + ", нажатий " + root.stats-clicks + ", прокруток " + root.stats-scrolls + ", отказов " + root.stats-rejected + "."; color: #5e574e; wrap: word-wrap; }
                        TextButton {
                            cross-axis-self-alignment: start;
                            label: root.session-recording ? "Остановить запись сессии" : "Записать сессию (JSONL)";
                            clicked => { root.toggle-session-record(); }
                        }
                        TextButton { cross-axis-self-alignment: start; label: "Открыть журнал"; clicked => { root.open-logs(); } }
                        Text { text: root.log-text; color: #5e574e; font-size: 12px; font-family: "Cascadia Mono"; wrap: word-wrap; }
                        }
                    }
                }

                if root.page == 10: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 40px;
                        spacing: 14px;
                        PageTitle { mark: 5; title: "Сцена"; lead: "Подсказка под кнопками говорит, как повторить движение. Полный список — на странице «Что умеет рука»."; }
                        Fade {
                            delay-ms: 40;
                            gap: 14px;
                        Text { text: "Распознавание лица сюда не входит. Подстройка руки и свои жесты уже есть в меню слева."; color: #8a8176; font-size: 13px; wrap: word-wrap; }
                        if !root.camera-on: PrimaryButton { cross-axis-self-alignment: start; label: "Включить камеру"; clicked => { root.start-camera(); root.set-play-mode(root.play-mode); } }
                        HorizontalLayout {
                            spacing: 8px;
                            Choice { label: "Курсор"; selected: root.play-mode == 0; clicked => { root.set-play-mode(0); } }
                            Choice { label: "Музыка"; selected: root.play-mode == 1; clicked => { root.set-play-mode(1); } }
                            Choice { label: "Магия"; selected: root.play-mode == 2; clicked => { root.set-play-mode(2); } }
                            Choice { label: "Рисунок"; selected: root.play-mode == 3; clicked => { root.set-play-mode(3); } }
                        }
                        Text { text: root.play-hint; color: #5e574e; wrap: word-wrap; }
                        if root.play-label != "" && root.play-label != "—": Text { text: root.play-label; color: #1f4d3a; font-size: 28px; font-weight: 600; wrap: word-wrap; }
                        if root.play-mode == 1: VerticalLayout {
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 8px;
                                Choice { label: "Пианино"; selected: root.play-instrument == 0; clicked => { root.set-play-instrument(0); } }
                                Choice { label: "Барабаны"; selected: root.play-instrument == 1; clicked => { root.set-play-instrument(1); } }
                                Choice { label: "Гитара"; selected: root.play-instrument == 2; clicked => { root.set-play-instrument(2); } }
                            }
                            if root.play-instrument == 0: HorizontalLayout {
                                spacing: 8px;
                                Choice { label: "Мягкий"; selected: root.play-preset == 0; clicked => { root.set-play-preset(0); } }
                                Choice { label: "Яркий"; selected: root.play-preset == 1; clicked => { root.set-play-preset(1); } }
                                Choice { label: "Щипок"; selected: root.play-preset == 2; clicked => { root.set-play-preset(2); } }
                            }
                            if root.play-instrument == 2: HorizontalLayout {
                                spacing: 8px;
                                Choice { label: "Чистый"; selected: root.play-preset == 0; clicked => { root.set-play-preset(0); } }
                                Choice { label: "Перегруз"; selected: root.play-preset == 1; clicked => { root.set-play-preset(1); } }
                                Choice { label: "Соло"; selected: root.play-preset == 2; clicked => { root.set-play-preset(2); } }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "Без звука"; color: #1c1915; vertical-alignment: center; }
                                Switch { checked: root.play-muted; toggled => { root.set-play-muted(self.checked); } }
                            }
                            Text { text: "Громкость"; color: #5e574e; }
                            Slider { minimum: 0; maximum: 1; value: root.play-volume; changed(value) => { root.set-play-volume(value); } }
                            Text { text: "Насколько лёгкое движение уже считается ударом"; color: #5e574e; wrap: word-wrap; }
                            Slider { minimum: 0.4; maximum: 2; value: root.play-sensitivity; changed(value) => { root.set-play-sensitivity(value); } }
                        }
                        if root.play-mode == 2: VerticalLayout {
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 8px;
                                Choice { label: "Огонь"; selected: root.play-element == 0; clicked => { root.set-play-element(0); } }
                                Choice { label: "Вода"; selected: root.play-element == 1; clicked => { root.set-play-element(1); } }
                                Choice { label: "Молния"; selected: root.play-element == 2; clicked => { root.set-play-element(2); } }
                                Choice { label: "Энергия"; selected: root.play-element == 3; clicked => { root.set-play-element(3); } }
                            }
                            Text { text: "Насколько лёгкое движение уже запускает эффект"; color: #5e574e; wrap: word-wrap; }
                            Slider { minimum: 0.4; maximum: 2; value: root.play-sensitivity; changed(value) => { root.set-play-sensitivity(value); } }
                        }
                        if root.play-mode == 3: VerticalLayout {
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 8px;
                                Choice { label: "Неон"; selected: root.play-brush == 0; clicked => { root.set-play-brush(0); } }
                                Choice { label: "Лента"; selected: root.play-brush == 1; clicked => { root.set-play-brush(1); } }
                                Choice { label: "Искры"; selected: root.play-brush == 2; clicked => { root.set-play-brush(2); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Choice { label: "Спектр"; selected: root.play-color == 0; clicked => { root.set-play-color(0); } }
                                Choice { label: "Скорость"; selected: root.play-color == 1; clicked => { root.set-play-color(1); } }
                                Choice { label: "Изумруд"; selected: root.play-color == 2; clicked => { root.set-play-color(2); } }
                                Choice { label: "Аврора"; selected: root.play-color == 3; clicked => { root.set-play-color(3); } }
                            }
                            Text { text: "Толщина линии"; color: #5e574e; }
                            Slider { minimum: 2; maximum: 14; value: root.play-thickness; changed(value) => { root.set-play-thickness(value); } }
                            Text { text: "Как быстро след тает. Левее — дольше остаётся."; color: #5e574e; wrap: word-wrap; }
                            Slider { minimum: 0.01; maximum: 0.12; value: root.play-fade; changed(value) => { root.set-play-fade(value); } }
                            TextButton { cross-axis-self-alignment: start; label: "Стереть рисунок"; clicked => { root.clear-art(); } }
                        }
                        }
                        Stage {
                            delay-ms: 0;
                            height: 520px;
                            background: #12151a;
                            if root.camera-on: Image { source: root.frame; width: 100%; height: 100%; image-fit: contain; }
                            if !root.camera-on: Text { text: "Здесь появится картинка. Клавиши, барабаны и эффекты рисуются прямо на ней."; color: #f6f3ee; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; wrap: word-wrap; }
                        }
                    }
                }

                if root.page == 11: MusicPage {
                    instrument: root.play-instrument;
                    preset: root.play-preset;
                    guitar-chord: root.play-guitar-chord;
                    guitar-mode: root.play-guitar-mode;
                    guitar-capo: root.play-guitar-capo;
                    muted: root.play-muted;
                    volume: root.play-volume;
                    sensitivity: root.play-sensitivity;
                    camera-on: root.camera-on;
                    show-camera: root.show-camera;
                    camera-status: root.camera-status;
                    hand-status: root.hand-status;
                    play-label: root.play-label;
                    play-hint: root.play-hint;
                    fps: root.fps;
                    frame: root.frame;
                    cameras: root.cameras;
                    start-camera => { root.start-camera(); }
                    stop-camera => { root.stop-camera(); }
                    select-camera(index) => { root.select-camera(index); }
                    refresh-cameras => { root.refresh-cameras(); }
                    open-camera-settings => { root.open-camera-settings(); }
                    set-play-mode(mode) => { root.set-play-mode(mode); }
                    set-instrument(index) => { root.set-play-instrument(index); }
                    set-preset(index) => { root.set-play-preset(index); }
                    set-guitar-chord(index) => { root.set-guitar-chord(index); }
                    set-guitar-mode(mode) => { root.set-guitar-mode(mode); }
                    set-guitar-capo(capo) => { root.set-guitar-capo(capo); }
                    pluck-guitar-string(index) => { root.pluck-guitar-string(index); }
                    set-muted(value) => { root.set-play-muted(value); }
                    set-volume(value) => { root.set-play-volume(value); }
                    set-sensitivity(value) => { root.set-play-sensitivity(value); }
                    set-show-camera(value) => { root.set-show-camera(value); }
                }

                if root.page == 9: VerticalLayout {
                    alignment: start;
                    padding: 40px;
                    spacing: 12px;
                    PageTitle { mark: 11; title: "Air Control"; lead: "Версия " + root.version + ". Рука перед обычной веб-камерой двигает курсор."; }
                    Fade {
                        delay-ms: 60;
                        gap: 12px;
                        Text { text: "Картинка не отправляется в интернет. Камера включается только кнопкой. Жест может нажать мышь, клавишу или громкость и не может открыть программу или запросить права администратора."; color: #1c1915; wrap: word-wrap; }
                        Text { text: "Страница «Музыкальные инструменты» играет через локальный MIDI-выход. «Сцена» также включает магию и рисунок; распознавание лица сюда не входит."; color: #5e574e; wrap: word-wrap; }
                        Text { text: "Если закрыть программу силой, пока зажата кнопка мыши, нажмите эту кнопку на настоящей мыши ещё раз."; color: #5e574e; wrap: word-wrap; }
                    }
                }
            }

            Rectangle {
                height: 40px;
                background: #efeae2;
                Text {
                    text: root.situation();
                    color: #5e574e;
                    font-size: 13px;
                    x: 28px;
                    vertical-alignment: center;
                    height: 100%;
                    width: parent.width - 56px;
                }
            }
        }
    }
}