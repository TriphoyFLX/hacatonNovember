import { ScrollView, Slider, Switch, ComboBox, LineEdit, Palette } from "std-widgets.slint";
import { CameraRow } from "components.slint";
import { MusicPage } from "music_page.slint";

export struct GestureRow {
    id: string,
    title: string,
    command: string,
    detail: string,
    how: string,
    custom: bool,
}

export struct ProfileRow {
    id: string,
    title: string,
    active: bool,
    mark: int,
    override-tune: bool,
    speed: float,
    smoothness: float,
    deadzone: float,
    confidence: float,
}

export struct ContextRuleRow {
    pattern: string,
    profile-id: string,
    profile-title: string,
    enabled: bool,
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    horizontal-stretch: 0;
    height: 48px;
    background: #1f4d3a;
    HorizontalLayout {
        padding-left: 22px;
        padding-right: 22px;
        alignment: center;
        Text { text: root.label; color: #f6f3ee; font-size: 16px; vertical-alignment: center; }
    }
    TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component TextButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();
    horizontal-stretch: 0;
    height: 36px;
    HorizontalLayout {
        padding-right: 8px;
        alignment: start;
        Text {
            text: root.label;
            color: root.danger ? #8d2f24 : #1f4d3a;
            font-size: 14px;
            vertical-alignment: center;
        }
    }
    TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component Choice inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 36px;
    background: root.selected ? #1f4d3a : #fffcf8;
    border-width: 1px;
    border-color: root.selected ? #1f4d3a : #d9d1c6;
    animate background { duration: 160ms; easing: ease-out; }
    animate border-color { duration: 160ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.label;
            color: root.selected ? #f6f3ee : #1c1915;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component IconTile inherits Rectangle {
    in property <int> kind: 0;
    in property <bool> hot: false;
    width: 44px;
    height: 44px;
    background: root.hot ? #1f4d3a : #e7f0ea;
    animate background { duration: 180ms; easing: ease-out; }
    property <color> ink: root.hot ? #f6f3ee : #1f4d3a;

    Path {
        x: 0px;
        y: 0px;
        width: 44px;
        height: 44px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 44;
        viewbox-height: 44;
        stroke: root.ink;
        fill: root.kind == 0 || root.kind == 4 ? root.ink : transparent;
        stroke-width: root.kind == 0 ? 0.8px : 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: root.kind == 1 ? "M 10.5 22 A 5 5 0 1 1 20.5 22 A 5 5 0 1 1 10.5 22 M 23.5 22 A 5 5 0 1 1 33.5 22 A 5 5 0 1 1 23.5 22"
            : root.kind == 2 ? "M 12 13 L 22 31 L 32 13"
            : root.kind == 3 ? "M 11 17.5 L 16 17.5 L 18 13.5 L 26 13.5 L 28 17.5 L 33 17.5 L 33 30.5 L 11 30.5 Z M 17 24 A 5 5 0 1 1 27 24 A 5 5 0 1 1 17 24"
            : root.kind == 4 ? "M 14 30 A 4 3.2 0 1 1 22 30 L 22 12 L 31 15.5 L 31 19 L 22 15.5"
            : root.kind == 5 ? "M 22 11 L 22 33 M 11 22 L 33 22"
            : root.kind == 6 ? "M 13 28 L 27 12 L 31 16 L 17 32 Z M 25 14 L 29 18"
            : root.kind == 7 ? "M 11 22 L 28 22 M 22 14 L 33 22 L 22 30"
            : root.kind == 8 ? "M 14.5 22 L 14.5 34 M 19.5 18 L 19.5 34 M 24.5 14 L 24.5 34 M 29.5 10 L 29.5 34"
            : root.kind == 9 ? "M 12 15 L 32 15 M 12 22 L 32 22 M 12 29 L 26 29"
            : root.kind == 12 ? "M 11 16 A 5 5 0 1 1 21 16 A 5 5 0 1 1 11 16 M 23 28 A 5 5 0 1 1 33 28 A 5 5 0 1 1 23 28"
            : root.kind == 14 ? "M 22 11 L 22 33 M 15 18 L 22 11 L 29 18 M 15 26 L 22 33 L 29 26"
            : root.kind == 15 ? "M 14.5 10 L 14.5 34 M 19.5 14 L 19.5 34 M 24.5 18 L 24.5 34 M 29.5 22 L 29.5 34"
            : root.kind == 16 ? "M 12 14 L 32 14 L 32 28 L 12 28 Z M 22 28 L 22 33 M 17 33 L 27 33"
            : root.kind == 17 ? "M 14 22 A 8 8 0 1 1 30 22 A 8 8 0 1 1 14 22 M 14 22 L 30 22 M 22 14 L 22 30"
            : root.kind == 18 ? "M 12 13 L 32 13 L 32 31 L 12 31 Z M 19 18 L 19 26 L 27 22 Z"
            : root.kind == 19 ? "M 16 13 L 16 31 L 31 22 Z"
            : root.kind == 20 ? "M 11 16 L 33 16 L 33 30 L 11 30 Z M 15 20 L 19 20 M 22 20 L 26 20 M 15 25 L 29 25"
            : "M 14.5 12 L 14.5 28 L 19 23.5 L 23 32 L 26 30.6 L 22 22 L 29.5 22 Z";
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> quiet: false;
    in property <int> mark: 0;
    callback clicked();
    height: 34px;
    TouchArea {
        clicked => { root.clicked(); }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { width: 2px; background: root.active ? #1f4d3a : transparent; }
            Text {
                text: root.label;
                color: root.active ? #1c1915 : (root.quiet ? #8a8176 : #5e574e);
                font-size: root.quiet ? 13px : 14px;
                font-weight: root.active ? 600 : 400;
                vertical-alignment: center;
            }
        }
    }
}

component GestureCard inherits Rectangle {
    in property <string> hand;
    in property <string> does;
    in property <string> how: "";
    in property <int> mark: 0;
    in property <int> delay-ms: 0;
    height: 128px;
    background: card-touch.has-hover ? #eef5f0 : #fffcf8;
    border-width: 1px;
    border-color: #e4dcd2;
    animate background { duration: 140ms; easing: ease-out; }
    card-touch := TouchArea {
        width: parent.width;
        height: parent.height;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            width: 44px;
            IconTile { kind: root.mark; hot: card-touch.has-hover; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.hand; color: #1c1915; font-size: 16px; font-weight: 600; wrap: word-wrap; }
            Text { text: root.does; color: #1f4d3a; font-size: 13px; wrap: word-wrap; }
            Text { text: root.how; color: #8a8176; font-size: 12px; wrap: word-wrap; }
        }
    }
}

component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> lead;
    in property <int> mark: 0;
    spacing: 8px;
    Text { text: root.title; color: #1c1915; font-size: 40px; font-weight: 600; wrap: word-wrap; }
    Text { text: root.lead; color: #5e574e; wrap: word-wrap; }
}

component Fade inherits VerticalLayout {
    in property <int> delay-ms: 0;
    in property <length> gap: 12px;
    spacing: root.gap;
    @children
}

component Stage inherits Rectangle {
    in property <int> delay-ms: 0;
    horizontal-stretch: 1;
    @children
}

component SheetRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> on;
    in property <int> mark: 9;
    in property <int> delay-ms: 0;
    callback clicked();
    height: 72px;
    background: root.on ? #e7f0ea : #fffcf8;
    border-width: 1px;
    border-color: root.on ? #c9ddd2 : #e5ddd2;
    animate background { duration: 140ms; easing: ease-out; }
    animate border-color { duration: 140ms; easing: ease-out; }
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 14px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                width: 44px;
                IconTile { kind: root.mark; }
            }
            Text { text: root.title; color: #1c1915; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.detail; color: #1f4d3a; vertical-alignment: center; }
        }
    }
}

export component AppWindow inherits Window {
    title: "AirControl";
    icon: @image-url("icon.png");
    default-font-family: "Segoe UI";
    default-font-size: 15px;
    min-width: 1080px;
    min-height: 700px;
    preferred-width: 1240px;
    preferred-height: 800px;
    background: #f5f5f7;
    // Instruments immersive mode takes over the OS window.
    in-out property <bool> stage-fullscreen: false;
    full-screen: root.stage-fullscreen;

    init => {
        Palette.color-scheme = ColorScheme.light;
    }

    in-out property <int> page: 0;
    changed page => {
        root.set-ui-page(root.page);
        // Camera picture / instrument HUD only on their pages — drop music when leaving tools.
        if (root.page != 12 && root.play-mode == 1) {
            root.set-play-mode(0);
        }
        if (root.page == 10) {
            root.set-play-mode(root.play-mode);
        }
        if (root.page != 12 && root.stage-fullscreen) {
            root.stage-fullscreen = false;
        }
    }
    in-out property <string> version: "0.9.0";
    in-out property <string> system-status: "Ожидание";
    in-out property <string> camera-status: "Камера выключена";
    in-out property <string> hand-status: "Рука не видна";
    in-out property <string> gesture-name: "—";
    in-out property <float> confidence: 0;
    in-out property <string> command-name: "—";
    in-out property <string> command-status: "ожидание";
    in-out property <string> rejection: "";
    in-out property <string> profile-name: "Рабочий стол";
    in-out property <string> context-line: "";
    in-out property <float> fps: 0;
    in-out property <float> latency-ms: 0;
    in-out property <float> capture-ms: 0;
    in-out property <float> inference-ms: 0;
    in-out property <float> ipc-ms: 0;
    in-out property <float> gesture-ms: 0;
    in-out property <float> dispatch-ms: 0;
    in-out property <bool> control-on: false;
    in-out property <bool> camera-on: false;
    changed camera-on => {
        if (root.camera-on && root.page == 10 && root.play-mode == 0) {
            root.set-play-mode(0);
        }
    }
    in-out property <bool> paused: false;
    in-out property <bool> ipc-ok: false;
    in-out property <float> cpu: 0;
    in-out property <float> ram-mb: 0;
    in-out property <int> vision-pid: 0;
    in-out property <string> error-text: "";
    in-out property <string> calibration-title: "";
    in-out property <string> calibration-hint: "";
    in-out property <float> calibration-progress: 0;
    in-out property <bool> calibration-active: false;
    in-out property <string> coach-line: "";
    in-out property <string> tracking-health: "трекинг в норме";
    in-out property <bool> dwell-click: false;
    in-out property <bool> snap-ui: true;
    in-out property <float> snap-radius-px: 36;
    in-out property <string> snap-target: "";
    in-out property <bool> session-recording: false;
    in-out property <int> session-frames: 0;
    in-out property <string> threshold-suggest: "";
    in-out property <float> suggested-confidence: 0;
    in-out property <bool> exam-active: false;
    in-out property <string> exam-hint: "";
    in-out property <float> exam-progress: 0;
    in-out property <bool> voice-ready: false;
    in-out property <bool> voice-listening: false;
    in-out property <string> voice-line: "";
    in-out property <string> voice-phrases: "";
    in-out property <int> stats-gestures: 0;
    in-out property <int> stats-commands: 0;
    in-out property <int> stats-clicks: 0;
    in-out property <int> stats-scrolls: 0;
    in-out property <int> stats-rejected: 0;
    in-out property <int> stats-reconnects: 0;
    in-out property <int> stats-uptime: 0;
    in-out property <string> log-text: "";
    in-out property <bool> show-camera: true;
    in-out property <bool> mirror: true;
    in-out property <bool> auto-context: true;
    in-out property <bool> air-keyboard: false;
    in-out property <int> play-mode: 0;
    in-out property <int> play-instrument: 2;
    in-out property <int> play-element: 0;
    in-out property <int> play-brush: 0;
    in-out property <int> play-color: 3;
    in-out property <int> play-preset: 0;
    in-out property <int> play-guitar-chord: 0;
    in-out property <int> play-guitar-mode: 0;
    in-out property <int> play-guitar-capo: 0;
    in-out property <float> play-guitar-s0: 0;
    in-out property <float> play-guitar-s1: 0;
    in-out property <float> play-guitar-s2: 0;
    in-out property <float> play-guitar-s3: 0;
    in-out property <float> play-guitar-s4: 0;
    in-out property <float> play-guitar-s5: 0;
    in-out property <bool> play-muted: false;
    in-out property <float> play-volume: 0.8;
    in-out property <float> play-sensitivity: 1;
    in-out property <float> play-thickness: 5.5;
    in-out property <float> play-fade: 0.045;
    in-out property <string> play-label: "—";
    in-out property <string> play-hint: "";
    in-out property <float> speed: 1.2;
    in-out property <float> smoothness: 0.45;
    in-out property <float> acceleration: 0.35;
    in-out property <float> deadzone: 2;
    in-out property <float> confidence-threshold: 0.72;
    in-out property <bool> depth-cursor: true;
    in-out property <float> depth-gain: 0.8;
    in-out property <int> quality-index: 1;
    in-out property <int> hand-index: 0;
    in-out property <int> sensitivity-index: 1;
    in-out property <string> selected-gesture: "";
    in-out property <string> selected-profile-id: "";
    in-out property <bool> profile-tune-override: false;
    in-out property <float> profile-tune-speed: 1.2;
    in-out property <float> profile-tune-smoothness: 0.45;
    in-out property <float> profile-tune-deadzone: 2;
    in-out property <float> profile-tune-confidence: 0.72;
    in-out property <image> frame;
    in-out property <image> play-frame;
    in-out property <bool> play-frame-ready: false;
    in-out property <[GestureRow]> gestures;
    in-out property <[CameraRow]> cameras;
    in-out property <[ProfileRow]> profiles;
    in-out property <[ContextRuleRow]> context-rules;
    in-out property <[string]> command-choices;
    in-out property <[string]> profile-id-choices;

    callback start-camera();
    callback stop-camera();
    callback set-control(bool);
    callback toggle-pause();
    callback emergency-stop();
    callback select-camera(int);
    callback select-profile(string);
    callback set-auto-context(bool);
    callback set-air-keyboard(bool);
    callback set-dwell-click(bool);
    callback set-snap-ui(bool);
    callback set-snap-radius(float);
    callback toggle-session-record();
    callback set-show-camera(bool);
    callback set-mirror(bool);
    callback set-quality(int);
    callback set-hand(int);
    callback set-sens-profile(int);
    callback set-speed(float);
    callback set-smoothness(float);
    callback set-acceleration(float);
    callback set-deadzone(float);
    callback set-confidence(float);
    callback set-depth-cursor(bool);
    callback set-depth-gain(float);
    callback add-context-rule(string, string);
    callback toggle-context-rule(string);
    callback remove-context-rule(string);
    callback reset-profile(string);
    callback set-profile-tune(string, bool, float, float, float, float);
    callback suggest-thresholds();
    callback apply-suggested-confidence(float);
    callback start-exam();
    callback calibration-start();
    callback calibration-next();
    callback calibration-cancel();
    callback calibration-drill();
    callback record-gesture(string, float);
    callback delete-gesture(string);
    callback assign-command(string, string);
    callback export-gestures();
    callback import-gestures();
    callback open-logs();
    callback refresh-cameras();
    callback open-camera-settings();
    callback set-play-mode(int);
    callback set-ui-page(int);
    callback set-play-instrument(int);
    callback set-play-element(int);
    callback set-play-brush(int);
    callback set-play-color(int);
    callback set-play-preset(int);
    callback set-guitar-chord(int);
    callback set-guitar-mode(int);
    callback set-guitar-capo(int);
    callback pluck-guitar-string(int);
    callback set-play-muted(bool);
    callback set-play-volume(float);
    callback set-play-sensitivity(float);
    callback set-play-thickness(float);
    callback set-play-fade(float);
    callback clear-art();
    callback set-voice-listen(bool);

    pure function situation() -> string {
        if root.error-text != "" { root.error-text }
        else if root.paused { "Пауза. Обычная мышь снова работает. Чтобы продолжить, нажмите «Продолжить»." }
        else if root.play-mode != 0 && !root.camera-on { "Сцена выбрана. Сначала включите камеру — мышь останется вашей." }
        else if root.play-mode != 0 { root.play-hint }
        else if !root.camera-on && root.camera-status == "Камера не найдена" { "Камера не найдена. Разрешите доступ в параметрах системы или нажмите «Проверить ещё раз»." }
        else if !root.camera-on && root.cameras.length > 0 { "Камера найдена, но картинка ещё выключена. Ничего не записывается." }
        else if !root.camera-on { root.camera-status }
        else if !root.control-on { "Камера включена. Курсор пока двигается только обычной мышью." }
        else { "Указательный палец двигает курсор. Короткий тычок пальцем — щелчок. Свайп ладонью в сторону на рабочем столе — следующее окно." }
    }

    HorizontalLayout {
        spacing: 0;
        // Keep the nav mounted (width 0) so fullscreen toggle does not tear down the tree.
        Rectangle {
            width: root.stage-fullscreen ? 0px : 288px;
            clip: true;
            background: transparent;
            VerticalLayout {
                padding: 12px;
                padding-right: 8px;
                // Floating white Apple card
                Rectangle {
                    border-radius: 24px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #e5e5ea;
                    VerticalLayout {
                        padding: 14px;
                        padding-top: 14px;
                        spacing: 2px;

                        // Brand card
                        Rectangle {
                            background: #ffffff;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: #e5e5ea;
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 10px;
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 10px;
                                    background: #1d1d1f;
                                    clip: true;
                                    Image {
                                        source: @image-url("logo.png");
                                        width: 36px;
                                        height: 36px;
                                        image-fit: cover;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    Text { text: "AirControl"; color: #1d1d1f; font-size: 14px; font-weight: 700; }
                                    Text { text: "Жесты вместо мыши"; color: #86868b; font-size: 11px; font-weight: 500; }
                                }
                            }
                        }

                        Rectangle { height: 14px; }
                        HorizontalLayout {
                            padding-left: 10px;
                            Text {
                                text: "РАБОТА";
                                color: #aeaeb2;
                                font-size: 11px;
                                font-weight: 600;
                            }
                        }
                        Rectangle { height: 4px; }
                        NavItem { mark: 0; label: "С чего начать"; active: root.page == 0; clicked => { root.page = 0; } }
                        NavItem { mark: 7; label: "Моя рука"; active: root.page == 1; clicked => { root.page = 1; } }
                        NavItem { mark: 1; label: "Что умеет рука"; active: root.page == 4; clicked => { root.page = 4; } }
                        NavItem { mark: 4; label: "Сцена"; active: root.page == 10; clicked => { root.page = 10; } }
                        NavItem { mark: 4; label: "Инструменты"; active: root.page == 12; clicked => {
                            root.page = 12;
                            root.set-play-mode(1);
                            root.set-play-instrument(2);
                        } }

                        Rectangle { height: 14px; }
                        HorizontalLayout {
                            padding-left: 10px;
                            Text {
                                text: "НАСТРОЙКА";
                                color: #aeaeb2;
                                font-size: 11px;
                                font-weight: 600;
                            }
                        }
                        Rectangle { height: 4px; }
                        NavItem { mark: 8; label: "Подстроить руку"; quiet: true; active: root.page == 3; clicked => { root.page = 3; } }
                        NavItem { mark: 9; label: "Свои движения"; quiet: true; active: root.page == 2; clicked => { root.page = 2; } }
                        NavItem { mark: 2; label: "Программы"; quiet: true; active: root.page == 5; clicked => { root.page = 5; } }
                        NavItem { mark: 3; label: "Камера"; quiet: true; active: root.page == 7; clicked => { root.page = 7; } }

                        Rectangle { height: 14px; }
                        HorizontalLayout {
                            padding-left: 10px;
                            Text {
                                text: "СПРАВКА";
                                color: #aeaeb2;
                                font-size: 11px;
                                font-weight: 600;
                            }
                        }
                        Rectangle { height: 4px; }
                        NavItem { mark: 10; label: "Если не работает"; quiet: true; active: root.page == 8 || root.page == 6; clicked => { root.page = 8; } }
                        NavItem { mark: 12; label: "Голос"; quiet: true; active: root.page == 11; clicked => { root.page = 11; } }
                        NavItem { mark: 11; label: "О программе"; quiet: true; active: root.page == 9; clicked => { root.page = 9; } }

                        Rectangle { vertical-stretch: 1; }

                        // Pause footer — toggles the same emergency pause as Ctrl+Shift+F12
                        pause-card := Rectangle {
                            background: pause-touch.has-hover ? #f5f5f7 : #ffffff;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: root.paused ? #1d1d1f : #e5e5ea;
                            animate background { duration: 120ms; easing: ease-out; }
                            pause-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.toggle-pause(); }
                            }
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 10px;
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: #1d1d1f;
                                    if !root.paused: HorizontalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        padding: 11px;
                                        Rectangle { width: 3px; height: 12px; border-radius: 1px; background: #ffffff; }
                                        Rectangle { width: 3px; height: 12px; border-radius: 1px; background: #ffffff; }
                                    }
                                    if root.paused: Text {
                                        width: 100%;
                                        height: 100%;
                                        text: "▶";
                                        color: #ffffff;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: root.paused ? "Продолжить" : "Пауза";
                                        color: #1d1d1f;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: root.paused ? "Управление остановлено" : "Ctrl + Shift + F12";
                                        color: #86868b;
                                        font-size: 11px;
                                        font-weight: 500;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 0;
            Rectangle {
                vertical-stretch: 1;
                if root.page == 0: HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 56px;
                    spacing: 56px;
                    alignment: center;
                    cross-axis-alignment: center;
                    VerticalLayout {
                        alignment: start;
                        spacing: 16px;
                        min-width: 380px;
                        max-width: 460px;
                        Text {
                            text: root.camera-status == "Камера не найдена" ? "Камера не найдена" : (!root.camera-on ? (root.cameras.length > 0 ? "Камера на месте" : "Сначала включите камеру") : (!root.control-on ? "Камера вас видит?" : "Рука вместо мыши"));
                            color: #1c1915;
                            font-size: 40px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        Text {
                            text: !root.camera-on ? (root.cameras.length > 0 ? "Кнопка включает картинку. Курсор останется у мыши, пока вы сами его не отдадите. Картинка не уходит с компьютера." : root.camera-status) : (!root.control-on ? "На картинке справа должна появиться линия по пальцам. Если она есть, можно отдать курсор указательному пальцу." : "Ведите кончиком указательного. Короткий тычок пальцем — щелчок. Обычная мышь тоже работает.");
                            color: #5e574e;
                            font-size: 16px;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 8px; }
                        if !root.camera-on: PrimaryButton { cross-axis-self-alignment: start; label: "Включить камеру"; clicked => { root.start-camera(); } }
                        if !root.camera-on && root.camera-status == "Камера не найдена": TextButton { cross-axis-self-alignment: start; label: "Проверить ещё раз"; clicked => { root.refresh-cameras(); } }
                        if !root.camera-on && root.camera-status == "Камера не найдена": TextButton { cross-axis-self-alignment: start; label: "Параметры камеры"; clicked => { root.open-camera-settings(); } }
                        if root.camera-on && !root.control-on: PrimaryButton { cross-axis-self-alignment: start; label: "Двигать курсор пальцем"; clicked => { root.set-control(true); } }
                        if root.control-on && !root.paused: TextButton { cross-axis-self-alignment: start; label: "Вернуть обычную мышь"; danger: true; clicked => { root.emergency-stop(); } }
                        if root.paused: PrimaryButton { cross-axis-self-alignment: start; label: "Продолжить"; clicked => { root.toggle-pause(); } }
                        if root.camera-on: TextButton { cross-axis-self-alignment: start; label: "Выключить камеру"; clicked => { root.stop-camera(); } }
                        if root.control-on && !root.paused: VerticalLayout {
                            alignment: start;
                            spacing: 4px;
                            Text { text: "Как пользоваться"; color: #1c1915; font-size: 16px; font-weight: 600; }
                            Text { text: "1. Включите камеру."; color: #5e574e; font-size: 14px; wrap: word-wrap; }
                            Text { text: "2. Нажмите «Двигать курсор пальцем»."; color: #5e574e; font-size: 14px; wrap: word-wrap; }
                            Text { text: "3. Указательный палец — курсор. Короткий тычок — клик."; color: #5e574e; font-size: 14px; wrap: word-wrap; }
                            Text { text: "4. Свайп ладонью в сторону — следующее окно (Alt+Tab) на рабочем столе."; color: #5e574e; font-size: 14px; wrap: word-wrap; }
                            Text { text: "5. Большой палец вверх — громче. Это на наборах «Рабочий стол» и «Медиа»."; color: #5e574e; font-size: 14px; wrap: word-wrap; }
                            Text { text: "Сейчас набор: " + root.profile-name + ". Полный список — «Что умеет рука»."; color: #8a8176; font-size: 13px; wrap: word-wrap; }
                        }
                    }
                    Rectangle { width: 1px; height: 240px; background: #d5cdc2; }
                    VerticalLayout {
                        width: 300px;
                        alignment: start;
                        spacing: 0;
                        if !root.camera-on: VerticalLayout {
                            alignment: start;
                            spacing: 0;
                            Text { text: "Что уже готово"; color: #8a8176; font-size: 13px; }
                            Rectangle { height: 16px; }
                            Text { text: root.cameras.length > 0 ? "●  Камера найдена" : "○  Камера найдена"; color: root.cameras.length > 0 ? #1c1915 : #8a8176; font-size: 16px; }
                            if root.cameras.length == 1: VerticalLayout {
                                for camera in root.cameras: Text { text: camera.label; color: #1f4d3a; font-size: 15px; }
                            }
                            if root.cameras.length > 1: VerticalLayout {
                                spacing: 6px;
                                for camera in root.cameras: Choice {
                                    label: camera.label;
                                    selected: camera.selected;
                                    clicked => { root.select-camera(camera.index); }
                                }
                            }
                            Rectangle { height: 12px; }
                            Text { text: "○  Картинка включена"; color: #8a8176; font-size: 16px; }
                            Rectangle { height: 12px; }
                            Text { text: "○  Рука в кадре"; color: #8a8176; font-size: 16px; }
                            Rectangle { height: 12px; }
                            Text { text: "○  Курсор отдан пальцу"; color: #8a8176; font-size: 16px; }
                            Rectangle { height: 18px; }
                            Text { text: "Картинка включится только по кнопке. До этого программа знает лишь имя камеры."; color: #5e574e; font-size: 13px; wrap: word-wrap; }
                        }
                        if root.camera-on: VerticalLayout {
                            alignment: start;
                            spacing: 10px;
                            Rectangle {
                                height: 280px;
                                background: #1c1915;
                                if root.show-camera: Image { source: root.frame; width: 100%; height: 100%; image-fit: contain; }
                                if !root.show-camera: Text { text: "Картинка скрыта. Линия руки всё ещё считается."; color: #f6f3ee; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; wrap: word-wrap; }
                            }
                            Text { text: root.hand-status; color: #1c1915; font-size: 16px; }
                            Text { text: root.gesture-name == "—" ? "Покажите ладонь внутри рамки." : root.gesture-name; color: #1f4d3a; font-size: 28px; font-weight: 600; wrap: word-wrap; }
                            Text { text: root.control-on ? root.command-name : "Курсор ещё слушает обычную мышь."; color: #5e574e; font-size: 14px; wrap: word-wrap; }
                            if root.coach-line != "": Text { text: root.coach-line; color: #8a4b12; font-size: 13px; wrap: word-wrap; }
                        }
                    }
                }

                if root.page == 1: HorizontalLayout {
                    padding: 40px;
                    spacing: 36px;
                    VerticalLayout {
                        alignment: start;
                        width: 300px;
                        spacing: 14px;
                        PageTitle { mark: 7; title: "Моя рука"; lead: "Курсор повторяет кончик указательного пальца. Сожмите большой и указательный, чтобы нажать."; }
                        Fade {
                            delay-ms: 60;
                            gap: 14px;
                            Text { text: root.hand-status; color: #1f4d3a; font-size: 16px; wrap: word-wrap; }
                            HorizontalLayout {
                                Text { text: "Показывать картинку"; color: #1c1915; vertical-alignment: center; }
                                Switch { checked: root.show-camera; toggled => { root.set-show-camera(self.checked); } }
                            }
                            HorizontalLayout {
                                Text { text: "Как в зеркале"; color: #1c1915; vertical-alignment: center; }
                                Switch { checked: root.mirror; toggled => { root.set-mirror(self.checked); } }
                            }
                            Text { text: "Зеркало включено, если рука вправо двигает курсор вправо."; color: #8a8176; font-size: 13px; wrap: word-wrap; }
                            if !root.camera-on: PrimaryButton { cross-axis-self-alignment: start; label: "Включить камеру"; clicked => { root.start-camera(); } }
                            if root.camera-on: TextButton { cross-axis-self-alignment: start; label: "Выключить камеру"; clicked => { root.stop-camera(); } }
                        }
                    }
                    Stage {
                        delay-ms: 120;
                        background: #1c1915;
                        if root.camera-on: Image { source: root.frame; width: 100%; height: 100%; image-fit: contain; }
                        if !root.camera-on: Text { text: "Здесь появится ваша рука."; color: #f6f3ee; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                    }
                }

                if root.page == 4: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 48px;
                        spacing: 22px;
                        PageTitle { title: "Что умеет рука"; lead: "Серая строка — как показать. Зелёная — что сделает текущий набор «" + root.profile-name + "»."; }
                        Text { text: "С чего начать"; color: #1c1915; font-size: 18px; font-weight: 600; }
                        Text { text: "Включите камеру и отдайте курсор пальцу. Большой палец меняет громкость на «Рабочий стол» и «Медиа». На других наборах то же движение делает другое — смотрите зелёную строку."; color: #5e574e; wrap: word-wrap; }
                        Text { text: "Движения набора «" + root.profile-name + "»"; color: #1c1915; font-size: 18px; font-weight: 600; wrap: word-wrap; }
                        for gesture[i] in root.gestures: VerticalLayout {
                            if !gesture.custom: GestureCard {
                                delay-ms: i * 20;
                                mark: 1;
                                hand: gesture.title;
                                does: gesture.command;
                                how: gesture.how;
                            }
                        }
                        Text { text: "Сцена"; color: #1c1915; font-size: 18px; font-weight: 600; }
                        Text { text: "Магия, рисунок и эмоции — на «Сцене». Пианино, барабаны, гитара и мелодия — на «Музыкальные инструменты». Они не двигают мышь."; color: #5e574e; wrap: word-wrap; }
                        GridLayout {
                            spacing: 12px;
                            GestureCard { row: 0; col: 0; delay-ms: 360; mark: 4; hand: "Пианино"; does: "Нота"; how: "Опустите палец на нижний ряд. Две руки вверх меняют инструмент."; }
                            GestureCard { row: 0; col: 1; delay-ms: 400; mark: 14; hand: "Барабаны"; does: "Удар"; how: "Кружок на ладони наведи на пэд — сожми кулак."; }
                            GestureCard { row: 1; col: 0; delay-ms: 440; mark: 6; hand: "Гитара"; does: "Струна"; how: "Слева ладонь выбирает аккорд. Справа проведите пальцем по струнам."; }
                            GestureCard { row: 1; col: 1; delay-ms: 460; mark: 8; hand: "Мелодия"; does: "Нота"; how: "Ладонь — коснись. Кулак — наведи и сожми. Мастер — быстрее."; }
                            GestureCard { row: 2; col: 0; delay-ms: 480; mark: 5; hand: "Магия"; does: "Эффект"; how: "Кулак — заряд. Щипок — струя. Раскройте кулак — вспышка."; }
                            GestureCard { row: 2; col: 1; delay-ms: 520; mark: 6; hand: "Рисунок"; does: "Линия"; how: "Открытая ладонь или палец рисуют. Кулак переносит руку без следа."; }
                            GestureCard { row: 3; col: 0; delay-ms: 560; mark: 8; hand: "Эмоции"; does: "Стикер"; how: "Каждая рука отдельно: сердце, лайк, дизлайк, V, окей, рок, ладонь, фак."; }
                        }
                        Text { text: "В браузере ладонь в сторону листает вкладки, в музыке — треки. Само движение то же."; color: #8a8176; font-size: 13px; wrap: word-wrap; }
                        Fade {
                            delay-ms: 380;
                            gap: 0px;
                            Rectangle {
                            background: #fffcf8;
                            border-width: 1px;
                            border-color: #e4dcd2;
                            VerticalLayout {
                                padding: 22px;
                                spacing: 12px;
                                Text { text: "Если курсор слишком резкий или слишком сонный"; color: #1c1915; font-size: 18px; font-weight: 600; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Choice { label: "Точнее"; selected: root.sensitivity-index == 0; clicked => { root.set-sens-profile(0); } }
                                    Choice { label: "Обычно"; selected: root.sensitivity-index == 1; clicked => { root.set-sens-profile(1); } }
                                    Choice { label: "Быстрее"; selected: root.sensitivity-index == 2; clicked => { root.set-sens-profile(2); } }
                                }
                                Text { text: "Насколько далеко уезжает курсор"; color: #5e574e; }
                                Slider { minimum: 0.6; maximum: 2.2; value: root.speed; changed(value) => { root.set-speed(value); } }
                                Text { text: "Насколько сглаживать дрожь. Правее — спокойнее."; color: #5e574e; wrap: word-wrap; }
                                Slider { minimum: 0; maximum: 1; value: root.smoothness; changed(value) => { root.set-smoothness(value); } }
                                Text { text: "Лёгкий разгон быстрого взмаха"; color: #5e574e; wrap: word-wrap; }
                                Slider { minimum: 0; maximum: 1; value: root.acceleration; changed(value) => { root.set-acceleration(value); } }
                                Text { text: "Мелкая дрожь, пиксели: " + Math.round(root.deadzone); color: #5e574e; }
                                Slider { minimum: 0; maximum: 12; value: root.deadzone; changed(value) => { root.set-deadzone(value); } }
                                Text { text: "Насколько уверенной должна быть рука для щелчка"; color: #5e574e; wrap: word-wrap; }
                                Slider { minimum: 0.4; maximum: 0.95; value: root.confidence-threshold; changed(value) => { root.set-confidence(value); } }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Учёт глубины: ближе к камере — спокойнее курсор"; color: #1c1915; vertical-alignment: center; wrap: word-wrap; }
                                    Switch { checked: root.depth-cursor; toggled => { root.set-depth-cursor(self.checked); } }
                                }
                                if root.depth-cursor: Text { text: "Сила компенсации глубины"; color: #5e574e; wrap: word-wrap; }
                                if root.depth-cursor: Slider { minimum: 0.3; maximum: 1.5; value: root.depth-gain; changed(value) => { root.set-depth-gain(value); } }
                            }
                            }
                        }
                    }
                }

                if root.page == 2: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 40px;
                        spacing: 12px;
                        PageTitle { mark: 9; title: "Свои движения"; lead: "Покажите движение один раз. Потом выберите, что оно делает: клавишу, окно, громкость или макрос из списка (копировать, вставить, клик и копировать). Это запомненный образец, не обучение."; }
                        Fade {
                            delay-ms: 50;
                            gap: 12px;
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                name-field := LineEdit { placeholder-text: "Как назвать движение"; horizontal-stretch: 1; min-width: 240px; }
                                PrimaryButton { cross-axis-self-alignment: start; label: "Запомнить"; clicked => { root.record-gesture(name-field.text, 0.55); } }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                commands := ComboBox { model: root.command-choices; horizontal-stretch: 1; min-width: 240px; }
                                TextButton { cross-axis-self-alignment: start; label: "Назначить выбранному"; clicked => { root.assign-command(root.selected-gesture, commands.current-value); } }
                            }
                            Text { text: "Макросы в списке — только разрешённые шаги (без оболочки). Пример: «Макрос: клик и копировать»."; color: #8a8176; font-size: 13px; wrap: word-wrap; }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 16px;
                                TextButton { cross-axis-self-alignment: start; label: "Удалить"; clicked => { root.delete-gesture(root.selected-gesture); } }
                                TextButton { cross-axis-self-alignment: start; label: "Сохранить в файл"; clicked => { root.export-gestures(); } }
                                TextButton { cross-axis-self-alignment: start; label: "Открыть из файла"; clicked => { root.import-gestures(); } }
                            }
                            Text { text: root.selected-gesture == "" ? "Нажмите на строку, чтобы выбрать движение." : "Выбрано: " + root.selected-gesture; color: #5e574e; }
                        }
                        for gesture[i] in root.gestures: SheetRow {
                            delay-ms: 120 + i * 60;
                            mark: gesture.custom ? 9 : 1;
                            title: gesture.title;
                            detail: gesture.command;
                            on: root.selected-gesture == gesture.id;
                            clicked => { root.selected-gesture = gesture.id; }
                        }
                    }
                }

                if root.page == 3: HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 40px;
                    spacing: 28px;
                    VerticalLayout {
                        alignment: start;
                        width: 400px;
                        spacing: 14px;
                        PageTitle { mark: 8; title: "Подстроить под вашу руку"; lead: root.calibration-hint; }
                        Text { text: root.calibration-title; color: #1f4d3a; font-size: 18px; wrap: word-wrap; }
                        Rectangle {
                            height: 4px;
                            background: #e5ddd2;
                            Rectangle {
                                height: 4px;
                                width: parent.width * root.calibration-progress;
                                background: #1f4d3a;
                                animate width { duration: 240ms; easing: ease-out; }
                            }
                        }
                        Text { text: "Зелёная строка — текущий шаг. После зоны идут проверка и тренировка щипка. Справа видно кадр. Курсор остаётся у мыши."; color: #1c1915; wrap: word-wrap; }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 12px;
                            if !root.calibration-active: PrimaryButton { cross-axis-self-alignment: start; label: "Начать"; clicked => { if (!root.camera-on) { root.start-camera(); } root.calibration-start(); } }
                            if root.calibration-active: PrimaryButton { cross-axis-self-alignment: start; label: "Дальше"; clicked => { root.calibration-next(); } }
                            if root.calibration-active: TextButton { cross-axis-self-alignment: start; label: "Отмена"; clicked => { root.calibration-cancel(); } }
                            if !root.calibration-active: TextButton { cross-axis-self-alignment: start; label: "Тренировка щипка"; clicked => { if (!root.camera-on) { root.start-camera(); } root.calibration-drill(); } }
                            if !root.calibration-active: TextButton { cross-axis-self-alignment: start; label: "Экзамен 4 жеста"; clicked => { if (!root.camera-on) { root.start-camera(); } root.start-exam(); } }
                        }
                        if root.exam-active: VerticalLayout {
                            spacing: 6px;
                            Text { text: "Экзамен: " + root.exam-hint; color: #1f4d3a; font-size: 16px; wrap: word-wrap; }
                            Rectangle {
                                height: 4px;
                                background: #e5ddd2;
                                Rectangle {
                                    height: 4px;
                                    width: parent.width * root.exam-progress;
                                    background: #8a4b12;
                                }
                            }
                        }
                        Text { text: root.camera-on ? root.hand-status : "Камера включится по кнопке «Начать»."; color: #1c1915; font-size: 15px; wrap: word-wrap; }
                        Text { text: root.camera-on ? (root.gesture-name == "—" ? "Покажите руку в кадре." : root.gesture-name) : ""; color: #1f4d3a; font-size: 22px; font-weight: 600; wrap: word-wrap; }
                        if root.coach-line != "": Text { text: root.coach-line; color: #8a4b12; font-size: 14px; wrap: word-wrap; }
                        if root.camera-on && !root.show-camera: TextButton { cross-axis-self-alignment: start; label: "Показать картинку"; clicked => { root.set-show-camera(true); } }
                    }
                    Stage {
                        delay-ms: 0;
                        background: #1c1915;
                        min-width: 420px;
                        if root.camera-on && root.show-camera: Image { source: root.frame; width: 100%; height: 100%; image-fit: contain; }
                        if root.camera-on && !root.show-camera: Text { text: "Картинка скрыта. Включите показ, чтобы видеть руку."; color: #f6f3ee; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; wrap: word-wrap; }
                        if !root.camera-on: Text { text: "Нажмите «Начать» — здесь появится ваша рука."; color: #f6f3ee; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; wrap: word-wrap; }
                    }
                }

                if root.page == 5: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 40px;
                        spacing: 12px;
                        PageTitle { mark: 2; title: "Разные программы"; lead: "Одни и те же движения могут листать презентацию, вкладки, проводник или музыку. Сначала свои правила по имени exe, иначе — заводская таблица."; }
                        Fade {
                            delay-ms: 40;
                            gap: 12px;
                            Text { text: root.context-line; color: #1c1915; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Менять набор само, по открытой программе"; color: #1c1915; vertical-alignment: center; }
                                Switch { checked: root.auto-context; toggled => { root.set-auto-context(self.checked); } }
                            }
                        }
                        Text { text: "Правила контекста"; color: #1c1915; font-size: 16px; font-weight: 600; }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            rule-pattern := LineEdit { placeholder-text: "explorer.exe или chrome"; horizontal-stretch: 1; min-width: 180px; }
                            rule-profile := ComboBox { model: root.profile-id-choices; horizontal-stretch: 1; min-width: 160px; }
                            TextButton {
                                cross-axis-self-alignment: start;
                                label: "Добавить";
                                clicked => {
                                    root.add-context-rule(rule-pattern.text, rule-profile.current-value);
                                }
                            }
                        }
                        for rule[i] in root.context-rules: HorizontalLayout {
                            spacing: 8px;
                            SheetRow {
                                delay-ms: 60 + i * 40;
                                mark: rule.enabled ? 2 : 10;
                                title: rule.pattern;
                                detail: rule.profile-title + (rule.enabled ? "" : " · выкл");
                                on: false;
                                clicked => { root.toggle-context-rule(rule.pattern); }
                            }
                            TextButton {
                                cross-axis-self-alignment: center;
                                label: "Удал.";
                                clicked => { root.remove-context-rule(rule.pattern); }
                            }
                        }
                        if root.context-rules.length > 0: Text {
                            text: "Нажмите правило, чтобы включить или выключить.";
                            color: #8a8176;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        for profile[i] in root.profiles: SheetRow {
                            delay-ms: 100 + i * 60;
                            mark: profile.mark;
                            title: profile.title;
                            detail: profile.active ? "сейчас" : (profile.override-tune ? "своя чувствительность" : "");
                            on: profile.active || root.selected-profile-id == profile.id;
                            clicked => {
                                root.selected-profile-id = profile.id;
                                root.select-profile(profile.id);
                            }
                        }
                        Fade {
                            delay-ms: 280;
                            gap: 12px;
                            if root.selected-profile-id != "": VerticalLayout {
                                spacing: 10px;
                                Text { text: "Чувствительность профиля «" + root.profile-name + "»"; color: #1c1915; font-weight: 600; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Свои значения вместо общих"; color: #1c1915; vertical-alignment: center; wrap: word-wrap; }
                                    Switch {
                                        checked: root.profile-tune-override;
                                        toggled => {
                                            root.set-profile-tune(
                                                root.selected-profile-id,
                                                self.checked,
                                                root.profile-tune-speed,
                                                root.profile-tune-smoothness,
                                                root.profile-tune-deadzone,
                                                root.profile-tune-confidence
                                            );
                                        }
                                    }
                                }
                                Text { text: "Скорость"; color: #5e574e; }
                                Slider {
                                    minimum: 0.6; maximum: 2.2;
                                    value: root.profile-tune-speed;
                                    changed(value) => {
                                        root.profile-tune-speed = value;
                                        root.set-profile-tune(
                                            root.selected-profile-id,
                                            true,
                                            value,
                                            root.profile-tune-smoothness,
                                            root.profile-tune-deadzone,
                                            root.profile-tune-confidence
                                        );
                                    }
                                }
                                Text { text: "Плавность"; color: #5e574e; }
                                Slider {
                                    minimum: 0; maximum: 1;
                                    value: root.profile-tune-smoothness;
                                    changed(value) => {
                                        root.profile-tune-smoothness = value;
                                        root.set-profile-tune(
                                            root.selected-profile-id,
                                            true,
                                            root.profile-tune-speed,
                                            value,
                                            root.profile-tune-deadzone,
                                            root.profile-tune-confidence
                                        );
                                    }
                                }
                                TextButton {
                                    cross-axis-self-alignment: start;
                                    label: "Сбросить профиль к заводскому";
                                    clicked => { root.reset-profile(root.selected-profile-id); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Режим клавиш: Enter, Escape, стрелки, копировать и вставить"; color: #1c1915; vertical-alignment: center; wrap: word-wrap; }
                                Switch { checked: root.air-keyboard; toggled => { root.set-air-keyboard(self.checked); } }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Клик удержанием: держите указательный ~0.6 с"; color: #1c1915; vertical-alignment: center; wrap: word-wrap; }
                                Switch { checked: root.dwell-click; toggled => { root.set-dwell-click(self.checked); } }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Прилипание клика к кнопкам и элементам окна"; color: #1c1915; vertical-alignment: center; wrap: word-wrap; }
                                Switch { checked: root.snap-ui; toggled => { root.set-snap-ui(self.checked); } }
                            }
                            Text { text: "Радиус прилипания"; color: #5e574e; }
                            Slider { minimum: 12; maximum: 80; value: root.snap-radius-px; changed(value) => { root.set-snap-radius(value); } }
                            if root.snap-target != "": Text { text: "Цель: " + root.snap-target; color: #1f4d3a; wrap: word-wrap; }
                            Text { text: "Сейчас набор: " + root.profile-name; color: #5e574e; }
                        }
                    }
                }

                if root.page == 7: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 40px;
                        spacing: 14px;
                        PageTitle { mark: 3; title: "Камера"; lead: "Выберите баланс между плавностью, детализацией и нагрузкой на компьютер."; }
                        Fade {
                            delay-ms: 50;
                            gap: 14px;
                        Text { text: "Картинка"; color: #1c1915; }
                        HorizontalLayout {
                            spacing: 8px;
                            Choice { label: "Легче для компьютера"; selected: root.quality-index == 0; clicked => { root.set-quality(0); } }
                            Choice { label: "Обычно"; selected: root.quality-index == 1; clicked => { root.set-quality(1); } }
                            Choice { label: "Подробнее"; selected: root.quality-index == 2; clicked => { root.set-quality(2); } }
                        }
                        Text { text: "Все режимы целят в 30 FPS. «Подробнее» берёт больший кадр камеры и тяжелее для CPU."; color: #5e574e; wrap: word-wrap; }
                        Text { text: "Ведущая рука"; color: #1c1915; }
                        HorizontalLayout {
                            spacing: 8px;
                            Choice { label: "Правая"; selected: root.hand-index == 0; clicked => { root.set-hand(0); } }
                            Choice { label: "Левая"; selected: root.hand-index == 1; clicked => { root.set-hand(1); } }
                            Choice { label: "Любая"; selected: root.hand-index == 2; clicked => { root.set-hand(2); } }
                        }
                        Text { text: "Если камер несколько, выберите свою"; color: #1c1915; }
                        for camera in root.cameras: Choice {
                            label: camera.label;
                            selected: camera.selected;
                            clicked => { root.select-camera(camera.index); }
                        }
                        Text { text: root.cameras.length == 0 ? root.camera-status : "Выбранная камера отмечена."; color: #5e574e; wrap: word-wrap; }
                        TextButton { cross-axis-self-alignment: start; label: "Проверить ещё раз"; clicked => { root.refresh-cameras(); } }
                        TextButton { cross-axis-self-alignment: start; label: "Параметры камеры"; clicked => { root.open-camera-settings(); } }
                        }
                    }
                }

                if root.page == 8 || root.page == 6: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 40px;
                        spacing: 10px;
                        PageTitle { mark: 10; title: "Если не работает"; lead: "Сначала верните обычную мышь. Потом прочитайте, что видит программа."; }
                        Fade {
                            delay-ms: 50;
                            gap: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                background: #fffcf8;
                                border-width: 1px;
                                border-color: #e5ddd2;
                                height: 72px;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 12px;
                                    alignment: center;
                                    Text { text: "" + root.stats-clicks; color: #1c1915; font-size: 22px; font-weight: 600; }
                                    Text { text: "щелчков"; color: #8a8176; font-size: 12px; }
                                }
                            }
                            Rectangle {
                                background: #fffcf8;
                                border-width: 1px;
                                border-color: #e5ddd2;
                                height: 72px;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 12px;
                                    alignment: center;
                                    Text { text: "" + root.stats-scrolls; color: #1c1915; font-size: 22px; font-weight: 600; }
                                    Text { text: "прокруток"; color: #8a8176; font-size: 12px; }
                                }
                            }
                            Rectangle {
                                background: #fffcf8;
                                border-width: 1px;
                                border-color: #e5ddd2;
                                height: 72px;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 12px;
                                    alignment: center;
                                    Text { text: "" + Math.round(root.fps); color: #1c1915; font-size: 22px; font-weight: 600; }
                                    Text { text: "кадров/с"; color: #8a8176; font-size: 12px; }
                                }
                            }
                        }
                        TextButton { cross-axis-self-alignment: start; label: "Вернуть обычную мышь"; danger: true; clicked => { root.emergency-stop(); } }
                        Text { text: "Здоровье трекинга: " + root.tracking-health; color: #1c1915; wrap: word-wrap; }
                        Text { text: "Камера: " + root.camera-status; color: #1c1915; wrap: word-wrap; }
                        Text { text: "Рука: " + root.hand-status; color: #1c1915; wrap: word-wrap; }
                        Text { text: root.rejection == "" ? "Жест не отклонён." : "Почему жест не сработал: " + root.rejection; color: #1c1915; wrap: word-wrap; }
                        if root.coach-line != "": Text { text: root.coach-line; color: #8a4b12; wrap: word-wrap; }
                        Text { text: "Кадров в секунду " + Math.round(root.fps) + ". От картинки до действия около " + Math.round(root.latency-ms) + " мс. Это замер этой минуты."; color: #5e574e; wrap: word-wrap; }
                        Text { text: "Связь с камерой: " + (root.ipc-ok ? "есть" : "нет") + ". Загрузка процессора " + Math.round(root.cpu) + "%, память " + Math.round(root.ram-mb) + " МБ."; color: #5e574e; wrap: word-wrap; }
                        Text { text: "За сессию: жестов " + root.stats-gestures + ", нажатий " + root.stats-clicks + ", прокруток " + root.stats-scrolls + ", отказов " + root.stats-rejected + "."; color: #5e574e; wrap: word-wrap; }
                        TextButton {
                            cross-axis-self-alignment: start;
                            label: root.session-recording ? "Остановить запись сессии" : "Записать сессию (JSONL)";
                            clicked => { root.toggle-session-record(); }
                        }
                        Text {
                            text: root.session-recording
                                ? ("Кадров в текущей записи: " + root.session-frames)
                                : (root.session-frames > 0
                                    ? ("Кадров в последней записи: " + root.session-frames)
                                    : "Запись сессии ещё не делалась.");
                            color: #5e574e;
                            wrap: word-wrap;
                        }
                        TextButton {
                            cross-axis-self-alignment: start;
                            label: "Подстроить пороги по последней сессии";
                            clicked => { root.suggest-thresholds(); }
                        }
                        if root.threshold-suggest != "": Text {
                            text: root.threshold-suggest;
                            color: #1c1915;
                            wrap: word-wrap;
                        }
                        if root.suggested-confidence > 0.4: TextButton {
                            cross-axis-self-alignment: start;
                            label: "Применить уверенность " + Math.round(root.suggested-confidence * 100) / 100;
                            clicked => { root.apply-suggested-confidence(root.suggested-confidence); }
                        }
                        TextButton { cross-axis-self-alignment: start; label: "Открыть журнал"; clicked => { root.open-logs(); } }
                        Text { text: root.log-text; color: #5e574e; font-size: 12px; font-family: "Cascadia Mono"; wrap: word-wrap; }
                        }
                    }
                }

                if root.page == 10: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 40px;
                        spacing: 14px;
                        PageTitle { mark: 5; title: "Сцена"; lead: "Курсор, магия и рисунок. Инструменты — на странице «Музыкальные инструменты»."; }
                        Fade {
                            delay-ms: 40;
                            gap: 14px;
                        Text { text: "Распознавание лица сюда не входит. Подстройка руки и свои жесты уже есть в меню слева."; color: #8a8176; font-size: 13px; wrap: word-wrap; }
                        if !root.camera-on: PrimaryButton { cross-axis-self-alignment: start; label: "Включить камеру"; clicked => { root.start-camera(); root.set-play-mode(root.play-mode == 1 ? 0 : root.play-mode); } }
                        HorizontalLayout {
                            spacing: 8px;
                            Choice { label: "Курсор"; selected: root.play-mode == 0; clicked => { root.set-play-mode(0); } }
                            Choice { label: "Магия"; selected: root.play-mode == 2; clicked => { root.set-play-mode(2); } }
                            Choice { label: "Рисунок"; selected: root.play-mode == 3; clicked => { root.set-play-mode(3); } }
                            Choice { label: "Эмоции"; selected: root.play-mode == 4; clicked => { root.set-play-mode(4); } }
                            TextButton { label: "→ Инструменты"; clicked => {
                                root.page = 12;
                                root.set-play-mode(1);
                                root.set-play-instrument(2);
                            } }
                        }
                        Text { text: root.play-hint; color: #5e574e; wrap: word-wrap; }
                        if root.play-label != "" && root.play-label != "—": Text { text: root.play-label; color: #1f4d3a; font-size: 28px; font-weight: 600; wrap: word-wrap; }
                        if root.play-mode == 2: VerticalLayout {
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 8px;
                                Choice { label: "Огонь"; selected: root.play-element == 0; clicked => { root.set-play-element(0); } }
                                Choice { label: "Вода"; selected: root.play-element == 1; clicked => { root.set-play-element(1); } }
                                Choice { label: "Молния"; selected: root.play-element == 2; clicked => { root.set-play-element(2); } }
                                Choice { label: "Энергия"; selected: root.play-element == 3; clicked => { root.set-play-element(3); } }
                            }
                            Text { text: "Насколько лёгкое движение уже запускает эффект"; color: #5e574e; wrap: word-wrap; }
                            Slider { minimum: 0.4; maximum: 2; value: root.play-sensitivity; changed(value) => { root.set-play-sensitivity(value); } }
                        }
                        if root.play-mode == 3: VerticalLayout {
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 8px;
                                Choice { label: "Неон"; selected: root.play-brush == 0; clicked => { root.set-play-brush(0); } }
                                Choice { label: "Лента"; selected: root.play-brush == 1; clicked => { root.set-play-brush(1); } }
                                Choice { label: "Искры"; selected: root.play-brush == 2; clicked => { root.set-play-brush(2); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Choice { label: "Спектр"; selected: root.play-color == 0; clicked => { root.set-play-color(0); } }
                                Choice { label: "Скорость"; selected: root.play-color == 1; clicked => { root.set-play-color(1); } }
                                Choice { label: "Изумруд"; selected: root.play-color == 2; clicked => { root.set-play-color(2); } }
                                Choice { label: "Аврора"; selected: root.play-color == 3; clicked => { root.set-play-color(3); } }
                            }
                            Text { text: "Толщина линии"; color: #5e574e; }
                            Slider { minimum: 2; maximum: 14; value: root.play-thickness; changed(value) => { root.set-play-thickness(value); } }
                            Text { text: "Как быстро след тает. Левее — дольше остаётся."; color: #5e574e; wrap: word-wrap; }
                            Slider { minimum: 0.01; maximum: 0.12; value: root.play-fade; changed(value) => { root.set-play-fade(value); } }
                            TextButton { cross-axis-self-alignment: start; label: "Стереть рисунок"; clicked => { root.clear-art(); } }
                        }
                        if root.play-mode == 4: VerticalLayout {
                            spacing: 10px;
                            Text { text: "Каждая рука даёт свой стикер. Можно сразу двумя."; color: #5e574e; wrap: word-wrap; }
                            Text { text: "Сердце · Лайк · Дизлайк · V · Окей · Рок · Ладонь · Фак"; color: #1f4d3a; font-weight: 600; wrap: word-wrap; }
                            Text { text: "Две руки в форме сердца или щипок большого и указательного — сердца."; color: #1c1915; wrap: word-wrap; }
                            Text { text: "Большой палец вверх — лайки. Большой вниз — дизлайки. Средний палец — фак."; color: #1c1915; wrap: word-wrap; }
                            Text { text: "Кольцо из большого и указательного — окей. Указательный и мизинец — рок."; color: #1c1915; wrap: word-wrap; }
                            Text { text: "Буква V — знак мира. Раскрытая ладонь — вспышки."; color: #1c1915; wrap: word-wrap; }
                            Text { text: "Держите жест: стикер выскакивает у этой руки и уходит вверх."; color: #8a8176; font-size: 13px; wrap: word-wrap; }
                            Text { text: "Насколько легко жест запускает реакцию"; color: #5e574e; wrap: word-wrap; }
                            Slider { minimum: 0.4; maximum: 2; value: root.play-sensitivity; changed(value) => { root.set-play-sensitivity(value); } }
                        }
                        }
                        Stage {
                            delay-ms: 0;
                            height: 520px;
                            background: #12151a;
                            if root.camera-on: Image {
                                source: root.frame;
                                width: 100%;
                                height: 100%;
                                image-fit: contain;
                            }
                            if !root.camera-on: Text {
                                text: "Включите камеру — здесь курсор, магия, рисунок и эмоции. Инструменты — в меню слева.";
                                color: #f6f3ee;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.page == 11: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 40px;
                        spacing: 14px;
                        PageTitle { mark: 12; title: "Голос"; lead: "Микрофон включается только этой кнопкой. Фраза выполняется, если она есть в списке и программа не на паузе. Курсор по-прежнему включается отдельно."; }
                        Fade {
                            delay-ms: 40;
                            gap: 12px;
                            if !root.voice-listening: PrimaryButton { cross-axis-self-alignment: start; label: "Слушать"; clicked => { root.set-voice-listen(true); } }
                            if root.voice-listening: PrimaryButton { cross-axis-self-alignment: start; label: "Остановить микрофон"; clicked => { root.set-voice-listen(false); } }
                            Text {
                                text: root.voice-line == "" ? "Пока ничего не услышано." : root.voice-line;
                                color: #1c1915;
                                font-size: 16px;
                                wrap: word-wrap;
                            }
                            if !root.voice-ready: Text {
                                text: "Модель голоса не найдена. Один раз: ./scripts/setup.sh на Mac/Linux или setup.ps1 на Windows (Python 3.11/3.12). Картинка и голос с компьютера не уходят.";
                                color: #8d2f24;
                                wrap: word-wrap;
                            }
                            Text { text: "Можно сказать"; color: #1c1915; font-weight: 600; }
                            Text { text: root.voice-phrases; color: #5e574e; wrap: word-wrap; }
                            Text {
                                text: "Незнакомая фраза ничего не нажимает. Пауза Ctrl+Shift+F12 выключает микрофон.";
                                color: #8a8176;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.page == 12: MusicPage {
                    instrument: root.play-instrument;
                    preset: root.play-preset;
                    guitar-chord: root.play-guitar-chord;
                    guitar-mode: root.play-guitar-mode;
                    guitar-capo: root.play-guitar-capo;
                    guitar-s0: root.play-guitar-s0;
                    guitar-s1: root.play-guitar-s1;
                    guitar-s2: root.play-guitar-s2;
                    guitar-s3: root.play-guitar-s3;
                    guitar-s4: root.play-guitar-s4;
                    guitar-s5: root.play-guitar-s5;
                    muted: root.play-muted;
                    volume: root.play-volume;
                    sensitivity: root.play-sensitivity;
                    camera-on: root.camera-on;
                    show-camera: root.show-camera;
                    camera-status: root.camera-status;
                    hand-status: root.hand-status;
                    play-label: root.play-label;
                    play-hint: root.play-hint;
                    fps: root.fps;
                    frame: root.frame;
                    play-frame: root.play-frame;
                    play-frame-ready: root.play-frame-ready;
                    cameras: root.cameras;
                    immersive: root.stage-fullscreen;
                    start-camera => { root.start-camera(); }
                    stop-camera => { root.stop-camera(); }
                    select-camera(index) => { root.select-camera(index); }
                    refresh-cameras => { root.refresh-cameras(); }
                    open-camera-settings => { root.open-camera-settings(); }
                    set-play-mode(mode) => { root.set-play-mode(mode); }
                    set-instrument(index) => { root.set-play-instrument(index); }
                    set-preset(index) => { root.set-play-preset(index); }
                    set-guitar-chord(index) => { root.set-guitar-chord(index); }
                    set-guitar-mode(mode) => { root.set-guitar-mode(mode); }
                    set-guitar-capo(capo) => { root.set-guitar-capo(capo); }
                    pluck-guitar-string(index) => { root.pluck-guitar-string(index); }
                    set-muted(value) => { root.set-play-muted(value); }
                    set-volume(value) => { root.set-play-volume(value); }
                    set-sensitivity(value) => { root.set-play-sensitivity(value); }
                    set-show-camera(value) => { root.set-show-camera(value); }
                    set-immersive(value) => { root.stage-fullscreen = value; }
                }

                if root.page == 9: VerticalLayout {
                    alignment: start;
                    padding: 40px;
                    spacing: 16px;
                    HorizontalLayout {
                        spacing: 18px;
                        Image {
                            source: @image-url("logo.png");
                            width: 72px;
                            height: 72px;
                            image-fit: cover;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text { text: "AirControl"; color: #1c1915; font-size: 36px; font-weight: 700; }
                            Text { text: "Версия " + root.version + "  ·  жесты вместо мыши"; color: #5e574e; font-size: 15px; }
                        }
                    }
                    Fade {
                        delay-ms: 60;
                        gap: 12px;
                        Text { text: "Картинка не отправляется в интернет. Камера включается только кнопкой. Жест может нажать мышь, клавишу или громкость и не может открыть программу или запросить права администратора."; color: #1c1915; wrap: word-wrap; }
                        Text { text: "«Музыкальные инструменты» — пианино, барабаны, гитара и мелодия. «Сцена» — курсор, магия и рисунок. Распознавание лица сюда не входит."; color: #5e574e; wrap: word-wrap; }
                        Text { text: "Если закрыть программу силой, пока зажата кнопка мыши, нажмите эту кнопку на настоящей мыши ещё раз."; color: #5e574e; wrap: word-wrap; }
                        Text { text: "Пауза в любой момент: Ctrl+Shift+F12. Обычная мышь снова работает, зажатые кнопки отпускаются."; color: #1c1915; wrap: word-wrap; }
                        Text { text: "На наборе «Рабочий стол» большой палец меняет громкость, свайп ладонью в сторону переключает окно (Alt+Tab). Громкость тем же пальцем есть ещё на «Медиа». На других наборах то же движение делает другое — смотрите «Что умеет рука»."; color: #5e574e; wrap: word-wrap; }
                        Text { text: "Если камера не стартует (нет OpenCV): один раз запустите setup.ps1 рядом с air-control.exe. Нужен Python 3.11 или 3.12."; color: #5e574e; wrap: word-wrap; }
                        Text { text: "Настройки лежат в папке пользователя AppData\\Local\\AirControl. Они пишутся сразу, без перезапуска."; color: #5e574e; wrap: word-wrap; }
                        Text { text: "Голос локальный: кнопка «Слушать» на странице «Голос». Фраза может нажать только то, что уже есть в списке команд. Микрофон сам не включается."; color: #5e574e; wrap: word-wrap; }
                    }
                }
            }

            Rectangle {
                height: 52px;
                background: #efeae2;
                VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.situation();
                        color: #5e574e;
                        font-size: 13px;
                        overflow: elide;
                    }
                    Text {
                        text: (root.voice-listening ? "Микрофон включён  ·  " : "") + "Набор: " + root.profile-name + "  ·  жест: " + root.gesture-name;
                        color: #8a8176;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
            }
        }
    }
}